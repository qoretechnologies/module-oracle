#!/usr/bin/make -f
# Copyright (C) 2026 David Nichols
# SPDX-License-Identifier: MIT
include /usr/share/dpkg/architecture.mk
export TZ = UTC
export LC_ALL = C.UTF-8
%:
	dh $@
override_dh_auto_configure:
	test "$(DEB_HOST_ARCH)" = amd64
	test "$(DEB_BUILD_ARCH)" = "$(DEB_HOST_ARCH)"
override_dh_auto_build:
override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS) $(DEB_BUILD_PROFILES)))
	python3 debian/install-client.py --verify-only
endif
override_dh_auto_install:
	python3 debian/install-client.py
# Oracle grants redistribution of unmodified programs. Do not rewrite ELF,
# JAR/ZIP signatures or vendor SDK example sources during Debian processing.
override_dh_strip:
override_dh_dwz:
override_dh_strip_nondeterminism:
override_dh_compress:
	dh_compress -X/usr/lib/ -X/upstream-signatures/
override_dh_makeshlibs:
	dh_makeshlibs -pqore-oracle-instantclient23 -V'qore-oracle-instantclient23 (>= 23.26.3.0.0)'
override_dh_shlibdeps:
	dh_shlibdeps -pqore-oracle-instantclient23 \
		-l$(CURDIR)/debian/qore-oracle-instantclient23/usr/lib/$(DEB_HOST_MULTIARCH)/oracle/23:$(CURDIR)/debian/compat-scan
# No binary code belongs to the SDK or compatibility-link packages.
override_dh_missing:
	dh_missing --fail-missing
