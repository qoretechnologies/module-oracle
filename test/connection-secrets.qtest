#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

/*  connection-secrets.qtest Copyright (C) 2026 Qore Technologies, s.r.o.

    Tests that the driver's exceptions do not show the connection's user name, password or database name (qore#6991):
    the driver's own descriptions do not name them, and they are masked in the messages of the Oracle client and
    server, which can name them (a service or alias name, or the user as the schema of an object).  The ORA- code and
    the problem are still named.

    Needs a privileged connection in QORE_DB_CONNSTR_ORACLE_SYS (for example "oracle:system/pass@db") to create and
    drop the test user; the cases are skipped with the reason if it is not set or the server is not available.
*/

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../build"
%requires QUnit
%requires Util
%requires oracle

%exec-class ConnectionSecretsTest

class ConnectionSecretsTest inherits QUnit::Test {
    private {
        *string sys_connstr;
        #! the parsed privileged connection
        hash<auto> sys_h;
        #! the test user, which is created for the run
        string user;
        #! true if the test user was created
        bool user_created;
        #! the reason that the cases are skipped, if they are
        *string skip_reason;
        #! the directory that the test was started in
        *string orig_dir;
        #! the temporary directory that the test runs in
        *string work_dir;
        #! the directory of the module built in the source tree
        string mod_dir;
    }

    #! the parts of the values that must not appear in an exception
    const SecretRx = "SECRET[123]";
    #! the password of the test user
    const UserPass = "p_SECRET2";
    #! a wrong password for the test user
    const WrongPass = "w_SECRET2";
    #! the database, service and alias name that is not known
    const UnknownDb = "d_SECRET3";

    constructor() : QUnit::Test("connection secrets", "1.0", \ARGV) {
        sys_connstr = ENV.QORE_DB_CONNSTR_ORACLE_SYS;
        # unique for the run, so that runs at the same time do not use the same user
        user = sprintf("u_SECRET1_%d", getpid());

        addTestCase("a login that fails with a wrong password", \loginFailure());
        addTestCase("an unknown service", \unknownService());
        addTestCase("an alias that cannot be found", \unknownAlias());
        addTestCase("an alias whose service is not known", \unknownAliasService());
        addTestCase("a SQL error on a working connection", \sqlError());
        addTestCase("a SQL error that names the user in a select", \sqlErrorNamesUser());
        addTestCase("an OCILIB error that names the user", \ocilibError());
        addTestCase("the secret checker finds every value", \checkerFindsSecrets());

        set_return_value(main());
    }

    globalSetUp() {
        if (!sys_connstr) {
            skip_reason = "QORE_DB_CONNSTR_ORACLE_SYS not set";
            return;
        }
        try {
            sys_h = parse_datasource(sys_connstr);
        } catch (hash<ExceptionInfo> ex) {
            # the description of a parse error contains the whole connection string
            throw ex.err, "QORE_DB_CONNSTR_ORACLE_SYS cannot be parsed";
        }
        # the module directory of the child process, as an absolute path, before the current directory changes
        mod_dir = normalize_dir(get_script_dir() + "/../build");

        # the Oracle client can write a log of failed connections (sqlnet.log) to the current directory that the
        # process had when the client was first used, so the test runs in a temporary directory, which is removed
        # afterwards
        orig_dir = getcwd();
        string dir = sprintf("%s/connection-secrets-%d", tmp_location(), getpid());
        if (mkdir(dir, 0700)) {
            throw "TEST-ERROR", sprintf("cannot create %y: %s", dir, strerror());
        }
        work_dir = dir;
        if (chdir(work_dir)) {
            throw "TEST-ERROR", sprintf("cannot change to %y: %s", work_dir, strerror());
        }

        Datasource sys(sys_connstr);
        try {
            sys.open();
        } catch (hash<ExceptionInfo> ex) {
            skip_reason = sprintf("the Oracle server is not available: %s: %s", ex.err,
                (ex.desc =~ x/\b(ORA-[0-9]+)\b/)[0] ?? "no ORA code");
            return;
        }
        on_exit sys.rollback();
        try {
            sys.exec(sprintf("create user %s identified by \"%s\"", user, UserPass));
        } catch (hash<ExceptionInfo> ex) {
            # ex: ORA-65096 in a CDB root, or ORA-01031 without the privilege
            skip_reason = sprintf("the test user cannot be created with QORE_DB_CONNSTR_ORACLE_SYS: %s: %s", ex.err,
                (ex.desc =~ x/\b(ORA-[0-9]+)\b/)[0] ?? "no ORA code");
            return;
        }
        user_created = True;
        sys.exec(sprintf("grant create session to %s", user));
        sys.commit();
    }

    #! removes a directory and everything in it
    private static removeDir(string dir) {
        Dir d();
        d.chdir(dir);
        foreach string f in (d.listFiles()) {
            unlink(dir + "/" + f);
        }
        foreach string subdir in (d.listDirs()) {
            removeDir(dir + "/" + subdir);
        }
        rmdir(dir);
    }

    globalTearDown() {
        if (work_dir) {
            chdir(orig_dir);
            removeDir(work_dir);
        }
        if (!user_created) {
            return;
        }
        Datasource sys(sys_connstr);
        on_exit sys.rollback();
        try {
            sys.exec(sprintf("drop user %s cascade", user));
        } catch (hash<ExceptionInfo> ex) {
            # ORA-01940: a session of the user is still there; it is ended, and the user dropped
            if (ex.desc !~ /ORA-01940/) {
                rethrow;
            }
            *hash<auto> q = sys.select("select sid, serial# as serial from v$session where username = %v",
                user.upr());
            for (int i = 0; i < q.sid.size(); ++i) {
                try {
                    sys.exec(sprintf("alter system kill session '%d,%d' immediate", q.sid[i], q.serial[i]));
                } catch (hash<ExceptionInfo> ex1) {
                    # ORA-00030: the session ended in the meantime
                    if (ex1.desc !~ /ORA-00030/) {
                        rethrow;
                    }
                }
            }
            sys.exec(sprintf("drop user %s cascade", user));
        }
    }

    private checkSkip() {
        if (skip_reason) {
            testSkip(skip_reason);
        }
    }

    #! returns the connection of the test user to the server of the privileged connection
    private hash<auto> userConnection(string pass) {
        return sys_h - ("user", "pass") + {"user": user, "pass": pass};
    }

    #! returns the strings of the exception and its chain: err, desc and every string in arg (recursively)
    private list<string> exceptionStrings(hash<ExceptionInfo> ex) {
        list<string> rv;
        *hash<ExceptionInfo> e = ex;
        while (e) {
            rv += e.err.toString();
            rv += e.desc.toString();
            addStrings(e.arg, \rv);
            e = e.next;
        }
        return rv;
    }

    private addStrings(auto v, reference<list<string>> l) {
        switch (v.typeCode()) {
            case NT_STRING: l += v; break;
            case NT_HASH: {
                foreach hash<auto> i in (v.pairIterator()) {
                    l += i.key;
                    addStrings(i.value, \l);
                }
                break;
            }
            case NT_LIST: {
                foreach auto i in (v) {
                    addStrings(i, \l);
                }
                break;
            }
            case NT_NOTHING: break;
            default: l += v.toString(); break;
        }
    }

    #! returns the strings of the exception that contain a secret value
    private list<string> findSecrets(hash<ExceptionInfo> ex) {
        return select exceptionStrings(ex), regex($1, SecretRx, RE_Caseless);
    }

    #! asserts that the exception names no secret value, and names the ORA- code and the problem
    private assertNoSecrets(hash<ExceptionInfo> ex, string code, string problem_rx, string label,
            bool real_db = False, string err = "DBI:ORACLE:OCI-ERROR") {
        list<string> found = findSecrets(ex);
        assertEq((), found, label + ": no secret values in the exception");
        assertEq(err, ex.err, label + ": err");
        assertRegex(code, ex.desc, label + ": the ORA- code is named");
        assertRegex(problem_rx, ex.desc, label + ": the problem is named");
        if (err == "DBI:ORACLE:OCI-ERROR") {
            assertEq("OCI-" + code.substr(4), ex.arg.alterr, label + ": the code is in arg");
        }
        if (real_db) {
            # the real database name of the connection is not shown either (as a whole name, as in "user@db")
            assertFalse(regex(ex.desc, "(?<![A-Za-z0-9_$#])" + quoteRegex(sys_h.db) + "(?![A-Za-z0-9_$#])",
                RE_Caseless), label + ": the database name is not shown: " + ex.desc);
        }
    }

    #! returns the string with the special characters of regular expressions escaped
    private static string quoteRegex(string str) {
        return regex_subst(str, "([\\\\^$.|?*+()\\[\\]{}/])", "\\$1", RE_Global);
    }

    #! returns the exception raised by opening a connection with the given values
    private hash<ExceptionInfo> openError(hash<auto> h) {
        Datasource ds(h);
        try {
            ds.open();
        } catch (hash<ExceptionInfo> ex) {
            return ex;
        }
        on_exit ds.close();
        throw "TEST-ERROR", sprintf("the connection was opened with %y", h - "pass");
    }

    loginFailure() {
        checkSkip();
        hash<ExceptionInfo> ex = openError(userConnection(WrongPass));
        assertNoSecrets(ex, "ORA-01017", "invalid credential|invalid username", "wrong password", True);
    }

    #! returns the host and port of the listener of the privileged connection, or NOTHING if they cannot be found
    private *hash<auto> getListener() {
        if (sys_h.host) {
            return {"host": sys_h.host, "port": sys_h.port ?? 1521};
        }
        # an Easy Connect string: [//]host[:port]/service
        *list<*string> m = (sys_h.db =~ x/^(?:\/\/)?([^:\/()\s]+)(?::([0-9]+))?\//);
        if (m) {
            return {"host": m[0], "port": m[1] ? m[1].toInt() : 1521};
        }
        # a TNS alias: its definition in a tnsnames.ora that the client reads
        list<string> dirs;
        if (ENV.TNS_ADMIN) {
            dirs += ENV.TNS_ADMIN;
        }
        if (ENV.ORACLE_HOME) {
            dirs += (ENV.ORACLE_HOME + "/network/admin", ENV.ORACLE_HOME);
        }
        dirs += "/usr/lib/oracle";
        string alias = sys_h.db.upr();
        foreach string dir in (dirs) {
            string path = dir + "/tnsnames.ora";
            if (!is_file(path)) {
                continue;
            }
            string text = ReadOnlyFile::readTextFile(path);
            # the definition of the alias: from "alias =" to the next definition
            *list<*string> d = (text =~ x/(?:^|\n)\s*([^\s=#()]+)\s*=\s*(\([\s\S]*?)(?=\n[^\s()#]|$)/g);
            for (int i = 0; i + 1 < d.size(); i += 2) {
                if (d[i].upr() != alias) {
                    continue;
                }
                *list<*string> a = (d[i + 1] =~ x/HOST\s*=\s*([^)\s]+)\s*\)\s*\(\s*PORT\s*=\s*([0-9]+)/i);
                if (a) {
                    return {"host": a[0], "port": a[1].toInt()};
                }
            }
        }
    }

    unknownService() {
        checkSkip();
        *hash<auto> l = getListener();
        if (!l) {
            testSkip(sprintf("the host and port of the listener of database %y cannot be determined", sys_h.db));
        }
        hash<ExceptionInfo> ex = openError({"type": "oracle", "user": user, "pass": UserPass, "db": UnknownDb}
            + l);
        # older clients: "listener does not currently know of service requested"
        assertNoSecrets(ex, "ORA-12514", "not registered|does not currently know of service", "unknown service");
    }

    unknownAlias() {
        checkSkip();
        hash<ExceptionInfo> ex = openError({"type": "oracle", "user": user, "pass": UserPass, "db": UnknownDb});
        # older clients: "could not resolve the connect identifier specified"
        assertNoSecrets(ex, "ORA-12154", "alias|could not resolve", "unknown alias");
    }

    #! a TNS alias whose service is not known: the server names the service of the alias's definition
    #! the Oracle client reads TNS_ADMIN once in a process, so the connection is made in a child process
    unknownAliasService() {
        checkSkip();
        *hash<auto> l = getListener();
        if (!l) {
            testSkip(sprintf("the host and port of the listener of database %y cannot be determined", sys_h.db));
        }
        string tns = work_dir + "/tns";
        if (mkdir(tns, 0700)) {
            throw "TEST-ERROR", sprintf("cannot create %y: %s", tns, strerror());
        }
        {
            File f();
            f.open2(tns + "/tnsnames.ora", O_CREAT | O_TRUNC | O_WRONLY);
            on_exit f.close();
            f.printf("a_SECRET4 = (DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=%s)(PORT=%d))"
                "(CONNECT_DATA=(SERVICE_NAME=s_SECRET5)))\n", l.host, l.port);
        }
        string script = work_dir + "/child.q";
        {
            File f();
            f.open2(script, O_CREAT | O_TRUNC | O_WRONLY);
            on_exit f.close();
            f.printf("%%modern\n%%requires oracle\ntry {\n"
                "    Datasource ds({\"type\": \"oracle\", \"user\": %y, \"pass\": %y, \"db\": \"a_SECRET4\"});\n"
                "    ds.open();\n    print(\"NO ERROR\");\n"
                "} catch (hash<ExceptionInfo> ex) {\n"
                "    printf(\"EXCEPTION\\n%%s\\n%%s\\n%%s\\n\", ex.err, ex.desc, ex.arg.alterr);\n}\n", user, UserPass);
        }
        string cmd = sprintf("TNS_ADMIN='%s' QORE_MODULE_DIR='%s'${QORE_MODULE_DIR:+:$QORE_MODULE_DIR} qore '%s' 2>&1",
            tns, mod_dir, script);
        int rc;
        string out = backquote(cmd, \rc);
        assertEq(0, rc, "the child process ran: " + out);
        # the output: "EXCEPTION", the err, the desc (which can have more lines) and the alterr arg
        assertRegex("^EXCEPTION\nDBI:ORACLE:OCI-ERROR\n", out, "the child process raised an exception: " + out);
        # the service name of the alias's definition is masked, as is the alias
        assertFalse(regex(out, "SECRET[0-9]", RE_Caseless), "no secret values in the exception: " + out);
        assertRegex("ORA-12514", out);
        assertRegex("not registered|does not currently know of service", out);
        assertRegex("\nOCI-12514\n$", out);
    }

    #! returns the exception raised by a select on a connection of the test user
    private hash<ExceptionInfo> selectError(Datasource ds, string sql, auto arg) {
        try {
            ds.select(sql, arg);
        } catch (hash<ExceptionInfo> ex) {
            return ex;
        }
        throw "TEST-ERROR", sprintf("%y succeeded", sql);
    }

    sqlError() {
        checkSkip();
        Datasource ds(userConnection(UserPass));
        on_exit ds.close();
        hash<ExceptionInfo> ex = selectError(ds, "select * from nope_table");
        # servers from 23ai name the table with its schema, which is the user
        assertNoSecrets(ex, "ORA-00942", "does not exist", "SQL error", True);
        if (ex.desc =~ /NOPE_TABLE/) {
            assertRegex("\"\\*\\*\\*\\*\"\\.\"NOPE_TABLE\"", ex.desc, "the schema is masked");
        }
        # the connection still works
        assertEq(1, ds.selectRow("select 1 as x from dual").x, "the connection works after the error");
    }

    sqlErrorNamesUser() {
        checkSkip();
        Datasource ds(userConnection(UserPass));
        on_exit ds.close();
        # a qualified name in lower case that differs from the user name
        hash<ExceptionInfo> ex = selectError(ds, sprintf("select * from %s.nope_table", user.lwr()));
        assertNoSecrets(ex, "ORA-00942", "does not exist", "SQL error with a qualified name", True);
        # a name that only starts with the user name is not the user name, and is not masked
        ex = selectError(ds, sprintf("select * from %s_x.nope_table", user));
        assertRegex("ORA-00942", ex.desc);
        if (ex.desc =~ /NOPE_TABLE/) {
            assertRegex("\"" + user.upr() + "_X\"\\.\"NOPE_TABLE\"", ex.desc, "a longer name is not masked");
        }
    }

    #! an error of the OCILIB layer (a named type that cannot be found) names the schema, which is the user
    ocilibError() {
        checkSkip();
        Datasource ds(userConnection(UserPass));
        on_exit ds.close();
        hash<ExceptionInfo> ex = selectError(ds, "select %v from dual",
            bindOracleObject(user.upr() + ".NOPE_TYPE", {}));
        assertNoSecrets(ex, "ORA-22303", "NOPE_TYPE", "OCILIB error", True, "ORACLE-OCI-ERROR");
        assertRegex("\"\\*\\*\\*\\*\"\\.\"NOPE_TYPE\"", ex.desc, "the schema is masked");
    }

    #! the checker itself: a negative test for the assertions of the other cases
    checkerFindsSecrets() {
        hash<ExceptionInfo> ex = cast<hash<ExceptionInfo>>({
            "type": "User",
            "err": "X",
            "desc": "no values",
            "arg": {"a": ("x", {"b": "the alias d_secret3"})},
            "next": cast<hash<ExceptionInfo>>({"type": "User", "err": "U_SECRET1", "desc": "p_SECRET2"}),
        });
        assertEq(("the alias d_secret3", "U_SECRET1", "p_SECRET2"), findSecrets(ex));
    }
}
