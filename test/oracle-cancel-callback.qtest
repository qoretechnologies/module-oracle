#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

%requires QUnit
%requires oracle

%exec-class OracleCancelCallbackTest

#! Test Oracle cancel callback functionality for sandbox interruption
class OracleCancelCallbackTest inherits QUnit::Test {
    private {
        *string connstr;
    }

    constructor() : QUnit::Test("OracleCancelCallbackTest", "1.0", \ARGV) {
        connstr = ENV.QORE_DB_CONNSTR_ORACLE ?? shift ARGV;

        if (!connstr) {
            addTestCase("No database connection configured", \testNoDatabaseConfigured());
        } else {
            addTestCase("Oracle cancel callback test", \testOracleCancel());
            addTestCase("Oracle blocked cancel test", \testOracleBlockedCancel());
        }

        set_return_value(main());
    }

    testNoDatabaseConfigured() {
        testSkip("QORE_DB_CONNSTR_ORACLE not set; skipping cancel callback tests");
    }

    #! Test that Oracle operations can be cancelled via the cancel callback
    testOracleCancel() {
        SandboxManager sm();
        Queue resultQueue();

        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.setSandboxManager(sm);
        p.loadModule("oracle");

        # Use a heavy SQL query that actively processes data - Cartesian joins keep
        # the Oracle query executor busy, which checks for OCIBreak signals during
        # active processing. DBMS_SESSION.SLEEP and PL/SQL loops are not reliably
        # interruptible by OCIBreak in Docker environments (TCP OOB data limitations).
        p.parse(sprintf("
%%new-style
%%require-types
%%strict-args

sub runQuery(Queue q, string connstr) {
    Datasource ds(connstr);
    ds.setAutoCommit(True);

    # verify connection works before signaling 'connected'
    ds.exec('select 1 from dual');
    q.push('connected');

    date start = now_us();
    try {
        # Cartesian join on all_objects creates a very large result set that
        # keeps the server actively processing; OCIBreak can interrupt this
        ds.exec('select count(*) from all_objects a cross join all_objects b');
        int elapsed_ms = (now_us() - start).durationMilliseconds();
        q.push({'cancelled': False, 'elapsed_ms': elapsed_ms});
    } catch (hash<ExceptionInfo> ex) {
        int elapsed_ms = (now_us() - start).durationMilliseconds();
        q.push({'cancelled': True, 'err': ex.err, 'desc': ex.desc, 'elapsed_ms': elapsed_ms});
    }
}
        ", "oracle_cancel"), "oracle_cancel_test");

        background p.callFunction("runQuery", resultQueue, connstr);

        auto connected = resultQueue.get(30s);
        assertEq("connected", connected, "Connected to Oracle");

        # wait long enough for the query to be actively running on the server
        usleep(2s);
        sm.requestInterrupt();

        # wait for the result - cancel should complete within a few seconds
        hash<auto> result = resultQueue.get(30s);
        assertTrue(result.cancelled, sprintf("Oracle query was cancelled (elapsed: %dms, err: %s, desc: %s)",
            result.elapsed_ms, result.err, result.desc));
        # if cancelled via OCIBreak, it should complete well before the query duration
        assertTrue(result.elapsed_ms < 15000,
            sprintf("Cancel was timely (elapsed: %dms, should be < 15000ms)", result.elapsed_ms));
    }

    #! Test Oracle cancel when query is blocked on server with PL/SQL
    testOracleBlockedCancel() {
        SandboxManager sm();
        Queue resultQueue();

        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.setSandboxManager(sm);
        p.loadModule("oracle");

        # Use a recursive query that generates a huge number of rows
        p.parse(sprintf("
%%new-style
%%require-types
%%strict-args

sub runBlockingQuery(Queue q, string connstr) {
    Datasource ds(connstr);
    ds.setAutoCommit(True);

    # verify connection works before signaling 'connected'
    ds.exec('select 1 from dual');
    q.push('connected');

    date start = now_us();
    try {
        # CONNECT BY generates a massive recursive result set, keeping the
        # server actively processing; OCIBreak can interrupt this
        ds.exec('select count(*) from (select level from dual connect by level <= 100000000)');
        int elapsed_ms = (now_us() - start).durationMilliseconds();
        q.push({'cancelled': False, 'elapsed_ms': elapsed_ms});
    } catch (hash<ExceptionInfo> ex) {
        int elapsed_ms = (now_us() - start).durationMilliseconds();
        q.push({'cancelled': True, 'err': ex.err, 'elapsed_ms': elapsed_ms});
    }
}
        ", "oracle_blocked"), "oracle_blocked_test");

        background p.callFunction("runBlockingQuery", resultQueue, connstr);

        auto connected = resultQueue.get(30s);
        assertEq("connected", connected, "Connected to Oracle");

        # wait long enough for the query to be actively running
        usleep(3s);
        sm.requestInterrupt();

        # wait for the result - cancel should complete within a few seconds
        hash<auto> result = resultQueue.get(30s);
        assertTrue(result.cancelled, sprintf("Blocked Oracle query was cancelled (elapsed: %dms, err: %s)",
            result.elapsed_ms, result.err));
        # if cancelled via OCIBreak, it should complete well before the query duration
        assertTrue(result.elapsed_ms < 15000,
            sprintf("Blocked cancel was timely (elapsed: %dms, should be < 15000ms)", result.elapsed_ms));
    }
}
