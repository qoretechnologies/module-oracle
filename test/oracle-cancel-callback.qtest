#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

%requires QUnit
%requires oracle

%exec-class OracleCancelCallbackTest

#! Test Oracle cancel callback functionality for sandbox interruption
class OracleCancelCallbackTest inherits QUnit::Test {
    private {
        *string connstr;
    }

    constructor() : QUnit::Test("OracleCancelCallbackTest", "1.0", \ARGV) {
        connstr = ENV.QORE_DB_CONNSTR_ORACLE ?? shift ARGV;

        if (!connstr) {
            addTestCase("No database connection configured", \testNoDatabaseConfigured());
        } else {
            addTestCase("Oracle cancel callback test", \testOracleCancel());
            addTestCase("Oracle blocked cancel test", \testOracleBlockedCancel());
        }

        set_return_value(main());
    }

    testNoDatabaseConfigured() {
        testSkip("QORE_DB_CONNSTR_ORACLE not set; skipping cancel callback tests");
    }

    #! The sandboxed code: it locks row 1 of the signal table, which the test then requests, and runs the statement
    #! under test, a PL/SQL block whose first action ends the transaction and so releases the row; the test's own
    #! request for the row returns exactly when the block is executing on the server, with no sleep and no polling
    #! (DBMS_LOCK would need EXECUTE granted by SYS, which the test schema does not have)
    const SandboxSource = "
%new-style
%require-types
%strict-args

sub runStatement(Queue q, string connstr, string lock_sql, string sql) {
    Datasource ds(connstr);
    try {
        ds.exec(lock_sql);
        q.push('locked');
        ds.exec(sql);
        q.push({'cancelled': False});
    } catch (hash<ExceptionInfo> ex) {
        q.push({'cancelled': True, 'err': ex.err, 'desc': ex.desc});
    }
    ds.rollback();
}
";

    #! the longest the test waits for a row lock or for the sandboxed code; a guard against a hang, never an
    #! expected time
    const Timeout = 60;

    #! the table whose rows the sessions lock
    const SignalTable = "qore_cancel_signal";

    #! Interrupts a sandboxed PL/SQL block once it is executing, and returns what the block's caller saw
    /** @param body the statements of the block after it has released row 1
    */
    private hash<auto> interruptExecuting(string body) {
        Datasource test(connstr);
        try {
            test.exec("create table " + SignalTable + " (a number primary key)");
            test.exec("insert into " + SignalTable + " values (1)");
            test.commit();
        } catch (hash<ExceptionInfo> ex) {
            # ORA-00955: the table exists from an earlier case
            test.rollback();
            if (ex.desc !~ /ORA-00955/) {
                rethrow;
            }
        }
        on_exit {
            test.rollback();
        }

        SandboxManager sm();
        Queue resultQueue();
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.setSandboxManager(sm);
        p.loadModule("oracle");
        p.parse(SandboxSource, "oracle_cancel_sandbox");

        string lock_sql = "select a from " + SignalTable + " where a = 1 for update";
        string sql = sprintf("declare n integer; begin rollback; %s end;", body);
        background p.callFunction("runStatement", resultQueue, connstr, lock_sql, sql);
        assertEq("locked", resultQueue.get(Timeout * 1000), "the sandboxed session holds row 1");
        # returns when the block under test has released row 1: it is executing on the server
        test.exec(sprintf("select a from %s where a = 1 for update wait %d", SignalTable, Timeout));

        # the interrupt runs the connection's cancel callback (OCIBreak), which cancels the executing block
        sm.requestInterrupt();
        return resultQueue.get(Timeout * 1000);
    }

    #! An executing statement is cancelled by the cancel callback when its sandbox is interrupted
    /** The statement is a cross join that counts 2.5 billion rows: DBMS_SESSION.SLEEP is not reliably interruptible
        by OCIBreak in containers (TCP out-of-band data)
    */
    testOracleCancel() {
        hash<auto> result = interruptExecuting("select count(*) into n from (select level from dual connect by "
            "level <= 50000) a, (select level from dual connect by level <= 50000) b;");
        assertTrue(result.cancelled, sprintf("the executing statement was cancelled (err: %s, desc: %s)",
            result.err, result.desc));
        assertRegex("ORA-01013", result.desc, sprintf("cancelled via OCIBreak with ORA-01013 (desc: %s)",
            result.desc));
    }

    #! A longer statement on the server is cancelled by the cancel callback when its sandbox is interrupted
    /** A cross join that counts 5 billion rows.  A statement waiting on a row lock or in DBMS_SESSION.SLEEP is not
        a case here: in containers OCIBreak does not end such waits (the break arrives as TCP out-of-band data, which
        a waiting server process does not see), while it does end a statement that is working
    */
    testOracleBlockedCancel() {
        hash<auto> result = interruptExecuting("select count(*) into n from (select level from dual connect by "
            "level <= 50000) a, (select level from dual connect by level <= 100000) b;");
        assertTrue(result.cancelled, sprintf("the longer statement was cancelled (err: %s, desc: %s)",
            result.err, result.desc));
        assertRegex("ORA-01013", result.desc, sprintf("cancelled via OCIBreak with ORA-01013 (desc: %s)",
            result.desc));
    }
}
