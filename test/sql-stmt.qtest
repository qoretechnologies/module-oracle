#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%disable-warning unreferenced-variable

%requires QUnit

%exec-class SqlStmtTest

const OracleTableName = "oracle_sqlstmt_test_table";

public class SqlStmtTest inherits QUnit::Test {
    private {
        *string connStr;
        *DatasourcePool ds;
    }

    constructor() : Test("SqlStmtTest", "1.1", \ARGV) {
        addTestCase("Test 1", \test1(), NOTHING);
        addTestCase("Test 2", \test2(), NOTHING);
        addTestCase("Test 3", \test3(), NOTHING);
        addTestCase("Test 4", \test4(), NOTHING);
        addTestCase("Test 5", \test5(), NOTHING);
        addTestCase("Columnar result test", \testColumnarResult(), NOTHING);

        # Return for compatibility with test harness that checks return value.
        set_return_value(main());
    }

    globalSetUp() {
        try {
            initDatasource();
            if (!ds) {
                return;
            }
        } catch (hash<ExceptionInfo> ex) {
            printf("Exception happened during datasource pool initialization:\n%s: %s\n", ex.err, ex.desc);
            delete ds;
            # a connection string is configured, so an unreachable DB is an error and not a reason to
            # skip; skipping here would report the test run as successful without a single assertion
            rethrow;
        }

        try {
            createTable();
        } catch (hash<ExceptionInfo> ex) {
            printf("Exception happened when creating test table:\n%s: %s\n", ex.err, ex.desc);
            delete ds;
            rethrow;
        }
    }

    globalTearDown() {
    }

    initDatasource() {
        connStr = ENV.QORE_DB_CONNSTR_ORACLE ? ENV.QORE_DB_CONNSTR_ORACLE : ENV.QORE_DB_CONNSTR;
        if (!connStr) {
            printf("No connection string set (QORE_DB_CONNSTR_ORACLE or QORE_DB_CONNSTR). Cannot run the tests.\n");
            return;
        }

        ds = new DatasourcePool(connStr);
    }

    auto getColumn(ColumnarResult result, string name) {
        string cname = result.columnNames().contains(name) ? name : name.upr();
        return result.getColumn(cname);
    }

    list asList(auto value) {
        return value.type() == Type::List ? value : value.toList();
    }

    createTable() {
        SQLStatement dropStmt(ds);
        dropStmt.prepare("drop table " + OracleTableName);

        on_exit dropStmt.commit();

        try {
            dropStmt.exec();
        } catch () { # ignore error
        }

        string createStr = "create table " + OracleTableName;
        createStr += " (ts timestamp, tstz timestamp with time zone, tsltz timestamp with local time zone, d date, r raw(64))";
        dropStmt.prepare(createStr);
        dropStmt.exec();
    }

    test1() {
        if (!ds) {
            testSkip("no DB connection");
        }
        SQLStatement insertStmt(ds);
        insertStmt.prepare("insert into " + OracleTableName + " values (%v, %v, %v, %v, %v)");

        SQLStatement selectStmt(ds);
        selectStmt.prepare("select * from " + OracleTableName);

        date now = now_us();
        binary bin = binary("hello");
        {
            code insert = sub () {
                insertStmt.bind(now, now, now, now, bin);

                insertStmt.beginTransaction();
                on_success insertStmt.commit();
                insertStmt.exec();
                assertEq(1, insertStmt.affectedRows());
            };

            insert();

            now = now_us();
            insert();

            now = now_us();
            insert();

            now = now_us();
            insert();
        }

        on_exit selectStmt.commit();

        selectStmt.exec();
        int rows;
        while (selectStmt.next()) {
            ++rows;
            hash rv = selectStmt.fetchRow();
        }
        assertEq(4, rows);
        selectStmt.close();

        selectStmt.exec();
        auto v = selectStmt.fetchRows(-1);
        assertEq(4, elements v);
        selectStmt.close();

        selectStmt.exec();
        v = selectStmt.fetchColumns(-1);
        assertEq(5, elements v);

        selectStmt.exec();
        v = selectStmt.fetchColumns(-1);
        assertEq(5, elements v);

        selectStmt.exec();
        *list l = selectStmt.fetchRows(3);
        assertEq(3, l.size());
        l = selectStmt.fetchRows(3);
        assertEq(1, l.size());
        l = selectStmt.fetchRows(3);
        assertEq(0, l.size());
        assertThrows("ORACLE-SELECT-ROWS-ERROR", sub() { l = selectStmt.fetchRows(3); });
    }

    test2() {
        if (!ds) {
            testSkip("no DB connection");
        }
        SQLStatement stmt(ds);
        stmt.prepare("begin select sysdate into :dt from dual; end;");

        on_exit stmt.commit();

        stmt.bindPlaceholders(Type::Date);
        auto v = stmt.getOutput();
        assertEq(1, elements v);

        stmt.close();

        stmt.bindPlaceholders(Type::Date);
        v = stmt.getOutput();
        assertEq(1, elements v);
    }

    test3() {
        if (!ds) {
            testSkip("no DB connection");
        }
        SQLStatement stmt(ds);
        stmt.prepare("select * from blahdf24g1df54g1df51sf5dg1dfsg5fd");
        try {
            stmt.beginTransaction();
            stmt.exec();
            fail();
        } catch (hash<ExceptionInfo> ex) {
            assertTrue(ex.err.val());
        }

        try {
            on_success stmt.commit();
            on_error stmt.rollback();
            auto rv = stmt.fetchColumns(-1);
            fail();
        } catch (hash<ExceptionInfo> ex) {
            assertTrue(ex.err.val());
        }
    }

    test4() {
        if (!ds) {
            testSkip("no DB connection");
        }
        SQLStatement deleteStmt(ds);
        deleteStmt.prepare("delete from " + OracleTableName);

        SQLStatement selectStmt(ds);
        selectStmt.prepare("select * from " + OracleTableName);

        {
            deleteStmt.beginTransaction();
            on_success deleteStmt.commit();
            deleteStmt.exec();
            assertEq(4, deleteStmt.affectedRows());
            deleteStmt.close();
        }

        selectStmt.exec();
        on_exit selectStmt.commit();
        auto rv = selectStmt.fetchRows();
        assertEq((), rv);
    }

    test5() {
        if (!ds) {
            testSkip("no DB connection");
        }
        SQLStatement plsql(ds);
        plsql.prepare("
declare
    var number;
begin
    select count(1) into var from user_objects where status = %v;
    :an_output := var;
end;");

        {
            plsql.beginTransaction();
            on_success plsql.commit();
            plsql.execArgs( ('VALID', Type::String) );
            hash ret = plsql.getOutput();
            plsql.close();
        }
    }

    testColumnarResult() {
        if (!ds) {
            testSkip("no DB connection");
        }

        on_exit ds.commit();

        ColumnarResult direct = ds.selectColumnar(
            "select 1 as id, 'Alice' as name from dual union all select 2 as id, 'Bob' as name from dual order by id");
        assertEq(2, direct.numRows());
        assertEq(2, direct.numCols());
        assertEq("buffer<int64>", getColumn(direct, "id").fullType());
        assertEq((1, 2), map int($1), asList(getColumn(direct, "id")));
        assertEq(("Alice", "Bob"), map trim($1), asList(getColumn(direct, "name")));

        ColumnarResult empty = ds.selectColumnar("select 1 as id, 'Alice' as name from dual where 1 = 0");
        assertEq(0, empty.numRows());
        assertEq(2, empty.numCols());
        assertEq("buffer<int64>", getColumn(empty, "id").fullType());

        ColumnarResult nullable = ds.selectColumnar(
            "select cast(null as number) as id from dual union all select 42 as id from dual order by id nulls first");
        assertEq("buffer<*int64>", getColumn(nullable, "id").fullType());
        assertEq((NOTHING, 42), asList(getColumn(nullable, "id")));

        ColumnarResult floats = ds.selectColumnar("
            select cast(1.5 as binary_double) as score from dual
            union all select cast(2.25 as binary_double) as score from dual order by score");
        assertEq("buffer<float64>", getColumn(floats, "score").fullType());
        assertEq((1.5, 2.25), asList(getColumn(floats, "score")));

        ColumnarResult decimalNumbers = ds.selectColumnar(
            "select 1.5 as amount from dual union all select 2.25 as amount from dual order by amount");
        assertEq("list<number>", getColumn(decimalNumbers, "amount").fullType());
        assertEq((1.5n, 2.25n), asList(getColumn(decimalNumbers, "amount")));

        ColumnarResult denseDecimals = ds.selectColumnar("
            select cast(null as number(18,2)) as amount from dual
            union all select cast(1.50 as number(18,2)) as amount from dual
            union all select cast(2.25 as number(18,2)) as amount from dual
            order by amount nulls first");
        assertEq("buffer<*decimal128>", getColumn(denseDecimals, "amount").fullType());
        assertEq((NOTHING, 1.5n, 2.25n), asList(getColumn(denseDecimals, "amount")));
        list<hash<auto>> decimalSchema = denseDecimals.schemaV2();
        assertEq("decimal128", decimalSchema[0].kind);
        assertEq(18, decimalSchema[0].precision);
        assertEq(2, decimalSchema[0].scale);

        SQLStatement stmt(ds);
        stmt.prepare("
            select 1 as id, 'Alice' as name from dual
            union all select 2 as id, 'Bob' as name from dual
            union all select 3 as id, 'Charlie' as name from dual
            order by id");
        stmt.exec();
        on_exit stmt.commit();

        ColumnarResult first = stmt.fetchColumnar(rows: 2);
        ColumnarResult rest = stmt.fetchColumnar(rows: -1);
        assertEq(2, first.numRows());
        assertEq(1, rest.numRows());
        assertEq("buffer<int64>", getColumn(first, "id").fullType());
        assertEq("buffer<int64>", getColumn(rest, "id").fullType());
        assertEq((1, 2), map int($1), asList(getColumn(first, "id")));
        assertEq((3,), map int($1), asList(getColumn(rest, "id")));
        assertEq(("Alice", "Bob"), map trim($1), asList(getColumn(first, "name")));
        assertEq(("Charlie",), map trim($1), asList(getColumn(rest, "name")));
    }
}
