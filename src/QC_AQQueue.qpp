// joins a thread when it goes out of scope; declared before the lock that is held when the thread is chosen, so that the
// thread is joined after that lock is released
/** The threads of the module deregister from the library after they have released the lock of their manager, which
    takes the library's thread list lock; fork() takes that lock before the managers' locks (see
    aq_register_fork_handlers()), so a thread that held a manager's lock while it joined such a thread could wait for
    the forking thread, which waits for the manager's lock.
*/
class AQThreadJoiner {
public:
   DLLLOCAL ~AQThreadJoiner() {
      if (set) {
         pthread_join(thread, nullptr);
      }
   }

   //! the thread to join
   DLLLOCAL void join(pthread_t t) {
      assert(!set);
      thread = t;
      set = true;
   }

private:
   pthread_t thread;
   bool set = false;
};

// reserves the thread ID that the Oracle client's notification thread uses when it must make a callback itself, as it
// does when the module's callback thread cannot be started (see AQQueuePriv::postAsyncMessage()); the ID is reserved
// while subscriptions are active
class AQCallbackThreadManager {
protected:
   pthread_t ora_thread;
   QoreThreadLock l;
   unsigned count;
   int tid;

public:
   DLLLOCAL AQCallbackThreadManager() : count(0), tid(0) {
   }

   DLLLOCAL ~AQCallbackThreadManager() {
      assert(!tid);
      assert(!count);
   }

   DLLLOCAL void inc() {
      AutoLocker al(l);
      if (!count) {
         assert(!tid);
         tid = q_reserve_foreign_thread_id();
         assert(tid > 0);
      }
      ++count;
   }

   DLLLOCAL void dec() {
      AutoLocker al(l);
      if (!--count) {
         q_release_reserved_foreign_thread_id(tid);
         tid = 0;
      }
   }

   DLLLOCAL int getTid() const {
      assert(tid);
      return tid;
   }

   DLLLOCAL unsigned getCount() const {
      return count;
   }

   //! the fork handlers of the lock (see aq_register_fork_handlers())
   /** The lock's holders reserve and release a thread ID, which takes the library's thread list lock.
   */
   DLLLOCAL static void forkPrepare(void* arg) {
      qore_fork_prepare_thread_lock(&static_cast<AQCallbackThreadManager*>(arg)->l);
   }

   DLLLOCAL static void forkParent(void* arg) {
      qore_fork_parent_thread_lock(&static_cast<AQCallbackThreadManager*>(arg)->l);
   }

   //! in the child, the subscriptions of the parent are abandoned (see AQQueuePriv::isForkedChild()), and the
   //! reserved thread ID belongs to the parent's notification thread, which does not exist in the child
   DLLLOCAL static void forkChild(void* arg) {
      AQCallbackThreadManager* m = static_cast<AQCallbackThreadManager*>(arg);
      m->count = 0;
      m->tid = 0;
      qore_fork_child_thread_lock(&m->l);
   }
};

AQCallbackThreadManager aqCallbackThreadManager;

// periodically pings the connections of the registered subscriptions and restores lost subscriptions
/** The watchdog thread serves the subscriptions of every caller, so no caller's sandbox governs it: each
    subscription is checked, restored and reported lost under the sandbox of the code that started it (see
    AQQueuePriv::checkSubscription()).  The lock is not held while a subscription is checked: a check blocks on the
    connection, and onSubscriptionLost() can start and stop subscriptions.
*/
class AQSubscriptionManager {
protected:
   typedef std::set<AQQueuePriv*> t_list;

   QoreThreadLock l;
   QoreCondition c;
   t_list objects;
   //! in a child process created with fork(): the subscriptions of the parent, which are not watched in the child
   /** They belong to the parent (see AQQueuePriv::isForkedChild()); their objects are not referenced by the set
   */
   t_list inherited;
   //! the watchdog thread, if started and not joined
   pthread_t checkThread;
   //! true if checkThread must be joined
   bool started = false;
   //! true while the watchdog thread is in its loop
   bool running = false;
   //! tells the watchdog thread to leave its loop
   bool quit = false;

public:
   DLLLOCAL AQSubscriptionManager() {
   }

   DLLLOCAL ~AQSubscriptionManager() {
      //printd(5, "~AQSubscriptionManager size: %d; tid: %d\n", objects.size(), tid);
      // std::set::size() is O(n) whereas set::empty() is O(1)
      assert(objects.empty());
      assert(!running);
   }

   DLLLOCAL int add(AQQueuePriv* o, ExceptionSink* xsink) {
      // the stack size is read before the lock is taken: reading it takes a lock of the library, which fork() takes
      // before the lock of the manager (see aq_register_fork_handlers())
      size_t stack_size = q_thread_get_stack_size();
      AQThreadJoiner finished;
      AutoLocker al(l);
      objects.insert(o);
      // a watchdog thread that is about to leave its loop because the last subscription was removed keeps running
      quit = false;
      if (running) {
         return 0;
      }
      // the previous watchdog thread has left its loop: it is joined once the lock is released
      reapUnlocked(finished);
      // the thread runs Qore code (onSubscriptionLost()) and Oracle client calls, so it gets the stack size of a Qore
      // thread rather than the system default, which is only 128 KiB with musl
      pthread_attr_t attr;
      pthread_attr_init(&attr);
      pthread_attr_setstacksize(&attr, stack_size);
      int rc = pthread_create(&checkThread, &attr, &AQSubscriptionManager::thread_helper, this);
      pthread_attr_destroy(&attr);
      if (rc) {
         objects.erase(o);
         xsink->raiseErrnoException("THREAD-CREATION-FAILURE", rc, "could not create global subscription watchdog thread");
         return -1;
      }
      started = true;
      running = true;
      return 0;
   }

   DLLLOCAL void remove(AQQueuePriv* o) {
      AutoLocker al(l);
      t_list::iterator i = objects.find(o);
      assert(i != objects.end());
      objects.erase(i);

      //printd(5, "AQSubscriptionManager::remove(): removed %p size: %d\n", o, (int)objects.size());

      // stop the watchdog thread if empty
      if (objects.empty()) {
         //printd(5, "AQSubscriptionManager::remove(): stopping last thread\n");
         quit = true;
         c.signal();
      }
   }

   //! Stops the watchdog thread and waits for it to end; called when the module is deleted
   DLLLOCAL void stop() {
      // the watchdog thread needs the lock to leave its loop: it is joined once the lock is released
      AQThreadJoiner finished;
      AutoLocker al(l);
      quit = true;
      c.signal();
      if (started) {
         finished.join(checkThread);
         started = false;
      }
   }

   DLLLOCAL void run() {
      QoreForeignThreadHelper qfth;
      //printd(5, "AQSubscriptionManager::run(): starting connection watchdog thread\n");

      AutoLocker al(l);
      while (!quit) {
         // the objects stay valid while they are checked without the lock
         std::vector<AQQueuePriv*> snapshot;
         try {
            snapshot.assign(objects.begin(), objects.end());
         } catch (std::bad_alloc&) {
            // the subscriptions are checked in the next round
            snapshot.clear();
         }
         for (AQQueuePriv* o : snapshot) {
            o->ref();
         }
         {
            AutoUnlocker aul(l);
            for (AQQueuePriv* o : snapshot) {
               o->checkSubscription();
               o->deref();
            }
         }
         // poll every 25 seconds
         if (!quit) {
            c.wait(l, 25000);
         }
      }
      running = false;
   }

   DLLLOCAL static void* thread_helper(void* context) {
       ((AQSubscriptionManager*)context)->run();
       return 0;
   }

   //! the fork handlers of the lock (see aq_register_fork_handlers())
   /** The lock's holders change the set and start the watchdog thread, holding no other lock.
   */
   DLLLOCAL static void forkPrepare(void* arg) {
      qore_fork_prepare_thread_lock(&static_cast<AQSubscriptionManager*>(arg)->l);
   }

   DLLLOCAL static void forkParent(void* arg) {
      qore_fork_parent_thread_lock(&static_cast<AQSubscriptionManager*>(arg)->l);
   }

   //! in the child, the watchdog thread does not exist, and the subscriptions of the parent are not watched
   /** Nothing is allocated or freed (see QoreForkHandler.h): the nodes of the set move to the inherited set.

       The condition is initialized again, as the watchdog thread, which normally waits on it, does not exist in the
       child: signaling a condition whose waiters are gone can wait for them forever (glibc).  Its old state is
       neither destroyed, as pthread_cond_destroy() would wait for the waiters, nor initialized again in place, as an
       implementation may refuse to initialize a condition in use: the storage is cleared first (no resources are
       held by a condition's state).
   */
   DLLLOCAL static void forkChild(void* arg) {
      AQSubscriptionManager* m = static_cast<AQSubscriptionManager*>(arg);
      m->inherited.merge(m->objects);
      m->started = false;
      m->running = false;
      m->quit = false;
      memset(static_cast<void*>(&m->c), 0, sizeof(m->c));
      new (&m->c) QoreCondition();
      qore_fork_child_thread_lock(&m->l);
   }

private:
   //! hands a watchdog thread that has left its loop to the joiner, which joins it without the lock; the lock must be
   //! held
   DLLLOCAL void reapUnlocked(AQThreadJoiner& joiner) {
      assert(!running);
      if (started) {
         joiner.join(checkThread);
         started = false;
      }
   }
};

AQSubscriptionManager aqSubscriptionManager;

// calls the AQQueue callbacks of every subscription, one at a time, on a thread of the module
/** The Oracle client delivers a subscription's notification on its notification thread while that thread holds a
    lock of the client's notification listener, which registering a subscription takes too (OCISubscriptionRegister()
    -> kpceinit()), and the client's connection locks are taken under it by the client calls of the callback:
    onAsyncMessage() typically calls getMessage(), which takes the queue's lock, while another thread can hold a
    queue's lock as it starts a subscription in the Oracle client, so a callback made on the notification thread could
    deadlock with it (the two threads take the two locks in the opposite order).  The notification thread
    therefore only queues the notification here, and onAsyncMessage() is called on this thread, with no lock of the
    Oracle client held.

    The watchdog reports a lost subscription right after it failed to ping its connection and to restore it, and
    onSubscriptionLost() typically restarts the subscription; started there, on the thread whose Oracle client calls
    on the lost connection just failed, a subscription is not registered with the server by the Oracle Instant Client
    on musl (Alpine) although OCISubscriptionRegister() succeeds, while it is registered from any other thread.  So
    onSubscriptionLost() is called on this thread too, outside the watchdog's OCI processing, on every platform.

    Each callback runs under the sandbox of the code that started the subscription (see
    AQQueuePriv::deliverAsyncMessage() and AQQueuePriv::notifySubscriptionLost()).  The thread runs while callbacks
    are queued; a finished thread is joined when the next callback starts a new one and when the module is deleted.
*/
class AQCallbackDispatcher {
public:
   //! the callbacks that the thread makes
   enum class Kind {
      //! AQQueue::onAsyncMessage(), for a notification of a subscription
      AsyncMessage,
      //! AQQueue::onSubscriptionLost(), for a subscription that the watchdog could not restore
      SubscriptionLost,
   };

   DLLLOCAL ~AQCallbackDispatcher() {
      assert(queue.empty());
      assert(!running);
   }

   //! Queues a callback for the given queue
   /** Takes over the reference to the private data and, for Kind::AsyncMessage, the weak reference to the object.
       Can be called on a thread that %Qore did not start, as it calls no %Qore code.

       @param kind the callback
       @param priv the private data of the queue (referenced)
       @param obj for Kind::AsyncMessage: the object of the queue (weakly referenced)
       @param subscription for Kind::AsyncMessage: the subscription that the notification is for (see
       AQQueuePriv::deliverAsyncMessage())

       @return 0 if the callback was queued, -1 if it could not be (then the caller must make it itself)
   */
   DLLLOCAL int post(Kind kind, AQQueuePriv* priv, QoreObject* obj = nullptr, uint64_t subscription = 0) {
      // the stack size is read before the lock is taken: reading it takes a lock of the library, which fork() takes
      // before the lock of the dispatcher (see aq_register_fork_handlers())
      size_t stack_size = q_thread_get_stack_size();
      AQThreadJoiner finished;
      AutoLocker al(l);
      try {
         queue.push_back(Callback{kind, priv, obj, subscription});
      } catch (std::bad_alloc&) {
         return -1;
      }
      if (running) {
         return 0;
      }
      // the previous thread has left its loop: it is joined once the lock is released
      reapUnlocked(finished);
      // the thread runs Qore code and Oracle client calls, so it gets the stack size of a Qore thread
      pthread_attr_t attr;
      pthread_attr_init(&attr);
      pthread_attr_setstacksize(&attr, stack_size);
      int rc = pthread_create(&thread, &attr, &AQCallbackDispatcher::thread_helper, this);
      pthread_attr_destroy(&attr);
      if (rc) {
         queue.pop_back();
         return -1;
      }
      started = true;
      running = true;
      return 0;
   }

   //! Waits for the queued callbacks to be made and joins the thread; called when the module is deleted
   DLLLOCAL void stop() {
      // the thread needs the lock to leave its loop: it is joined once the lock is released
      AQThreadJoiner finished;
      AutoLocker al(l);
      if (started) {
         finished.join(thread);
         started = false;
      }
   }

private:
   //! a queued callback
   struct Callback {
      Kind kind;
      //! the private data of the queue (referenced)
      AQQueuePriv* priv;
      //! for Kind::AsyncMessage: the object of the queue (weakly referenced)
      QoreObject* obj;
      //! for Kind::AsyncMessage: the subscription that the notification is for
      uint64_t subscription;
   };

   QoreThreadLock l;
   //! the queued callbacks
   std::list<Callback> queue;
   //! in a child process created with fork(): the callbacks that the parent makes
   /** Their references belong to the parent; they are never released in the child
   */
   std::list<Callback> inherited;
   //! the thread, if started and not joined
   pthread_t thread;
   //! true if the thread must be joined
   bool started = false;
   //! true while the thread is in its loop
   bool running = false;

   DLLLOCAL void run() {
      QoreForeignThreadHelper qfth;
      AutoLocker al(l);
      while (!queue.empty()) {
         Callback cb = queue.front();
         queue.pop_front();
         AutoUnlocker aul(l);
         if (cb.kind == Kind::AsyncMessage) {
            cb.priv->deliverAsyncMessage(cb.obj, cb.subscription);
            cb.obj->tDeref();
         } else {
            cb.priv->notifySubscriptionLost();
         }
         cb.priv->deref();
      }
      running = false;
   }

   //! hands a thread that has left its loop to the joiner, which joins it without the lock; the lock must be held
   DLLLOCAL void reapUnlocked(AQThreadJoiner& joiner) {
      assert(!running);
      if (started) {
         joiner.join(thread);
         started = false;
      }
   }

   DLLLOCAL static void* thread_helper(void* context) {
      static_cast<AQCallbackDispatcher*>(context)->run();
      return nullptr;
   }

public:
   //! the fork handlers of the lock (see aq_register_fork_handlers())
   /** The lock's holders change the queue and start the thread, holding no other lock.
   */
   DLLLOCAL static void forkPrepare(void* arg) {
      qore_fork_prepare_thread_lock(&static_cast<AQCallbackDispatcher*>(arg)->l);
   }

   DLLLOCAL static void forkParent(void* arg) {
      qore_fork_parent_thread_lock(&static_cast<AQCallbackDispatcher*>(arg)->l);
   }

   //! in the child, the thread does not exist, and the parent makes the queued callbacks
   /** Nothing is allocated or freed (see QoreForkHandler.h): the queued callbacks move to the inherited list.
   */
   DLLLOCAL static void forkChild(void* arg) {
      AQCallbackDispatcher* d = static_cast<AQCallbackDispatcher*>(arg);
      d->inherited.splice(d->inherited.end(), d->queue);
      d->started = false;
      d->running = false;
      qore_fork_child_thread_lock(&d->l);
   }
};

AQCallbackDispatcher aqCallbackDispatcher;

// the last subscription identifier that was assigned; see AQQueuePriv::startSubscription()
static std::atomic<uint64_t> aq_last_subscription{0};

// the process whose Oracle client started its notification listener, or 0 if no subscription was started: the first
// subscription of a process starts the Oracle client's notification listener, which serves the process from then
// on; a child process created with fork() inherits the client's notification state but not the listener's thread, so
// a subscription that it started would not be notified, and stopping it would fail with ORA-24950 (see
// AQQueuePriv::startSubscription())
static std::atomic<pid_t> aq_notification_pid{0};

// the fork handlers of the module's process-wide locks (see QoreForkHandler.h)
static QoreForkHandlerRegistration* aq_callback_thread_fork_reg = nullptr;
static QoreForkHandlerRegistration* aq_subscription_fork_reg = nullptr;
static QoreForkHandlerRegistration* aq_callback_dispatcher_fork_reg = nullptr;

DLLLOCAL void aq_unregister_fork_handlers();
void aq_unregister_fork_handlers() {
   qore_unregister_fork_handler(aq_callback_dispatcher_fork_reg);
   aq_callback_dispatcher_fork_reg = nullptr;
   qore_unregister_fork_handler(aq_subscription_fork_reg);
   aq_subscription_fork_reg = nullptr;
   qore_unregister_fork_handler(aq_callback_thread_fork_reg);
   aq_callback_thread_fork_reg = nullptr;
}

// registers the fork handlers of the module's process-wide locks; called in the module's initialization function
/** A child process created with fork() runs only the forking thread: a lock that another thread held then would
    stay held in the child, and the watchdog and dispatch threads exist only in the parent.  The locks are acquired
    before fork(), so that the managers' data are consistent in the child, which resets their thread state.

    The holders of the subscription and dispatcher locks take no lock of the library (they read the thread stack
    size before they take their lock), so they are leaves; the holders of the callback thread lock reserve and release
    thread IDs, which takes the library's thread list lock.

    @return 0 if the handlers were registered, -1 if there was no memory for a registration
*/
DLLLOCAL int aq_register_fork_handlers();
int aq_register_fork_handlers() {
   aq_callback_thread_fork_reg = qore_register_fork_handler(QFR_MODULE_CANCELLABLE, "oracle_aq_callback_thread",
      AQCallbackThreadManager::forkPrepare, AQCallbackThreadManager::forkParent, AQCallbackThreadManager::forkChild,
      &aqCallbackThreadManager);
   aq_subscription_fork_reg = qore_register_fork_handler(QFR_MODULE_LEAF, "oracle_aq_subscriptions",
      AQSubscriptionManager::forkPrepare, AQSubscriptionManager::forkParent, AQSubscriptionManager::forkChild,
      &aqSubscriptionManager);
   aq_callback_dispatcher_fork_reg = qore_register_fork_handler(QFR_MODULE_LEAF, "oracle_aq_callbacks",
      AQCallbackDispatcher::forkPrepare, AQCallbackDispatcher::forkParent, AQCallbackDispatcher::forkChild,
      &aqCallbackDispatcher);
   if (!aq_callback_thread_fork_reg || !aq_subscription_fork_reg || !aq_callback_dispatcher_fork_reg) {
      aq_unregister_fork_handlers();
      return -1;
   }
   return 0;
}

DLLLOCAL void aq_module_delete();
void aq_module_delete() {
   // no subscription is reported lost once the watchdog is stopped
   aqSubscriptionManager.stop();
   aqCallbackDispatcher.stop();
   aq_unregister_fork_handlers();
}

// called on the Oracle client's notification thread, which holds a lock of the client's notification listener: the
// notification is queued for the dispatch thread (see AQCallbackDispatcher)
void on_async_message(OCI_Dequeue* deq) {
   reinterpret_cast<AQQueuePriv*>(deq->user_ctx)->postAsyncMessage();
}

bool check_hash_key(const QoreHashNode* h, const char* key, const char* err, std::string& value,
        ExceptionSink *xsink) {
    QoreValue p = h->getKeyValue(key);
    if (p.isNothing())
        return false;

    if (p.getType() != NT_STRING) {
        xsink->raiseException(err, "'%s' key is not type 'string' but is type '%s'", key, p.getTypeName());
        return false;
    }
    QoreStringValueHelper str(p);
    value.assign(str->c_str(), str->size());
    return true;
}

AQQueuePriv::AQQueuePriv(Datasource *ds, const QoreStringNode *tname, const QoreStringNode *qname, ExceptionSink *xsink)
    : m_conn(ds->getPrivateData<QoreOracleConnection>()),
      m_ds(ds),
      m_tname(tname->stringRefSelf()),
      m_qname(qname->stringRefSelf()),
      m_typeInfo(0),
      m_enqueue(0),
      m_dequeue(0),
      m_port(0),
      m_timeout(0),
      m_hasSubscription(false),
      valid(true) {
   //printd(5, "AQQueuePriv::AQQueuePriv() this: %p\n", this);
   connect(xsink);
}

AQQueuePriv::~AQQueuePriv() {
   //printd(5, "AQQueuePriv::~AQQueuePriv() this: %p\n", this);
   assert(!m_enqueue);
   assert(!m_dequeue);
   assert(!m_typeInfo);
   assert(!m_tname);
   assert(!m_qname);
   assert(!m_ds);
}

void AQQueuePriv::destructor(ExceptionSink* xsink) {
   //printd(5, "AQQueuePriv::destructor() this: %p\n", this);
   if (isForkedChild()) {
      // the lock is not taken: the parent's watchdog thread can have held it when the process was created
      abandon();
      return;
   }
   AutoLocker al(l);
   destructorUnlocked(xsink);
}

void AQQueuePriv::abandon() {
   if (!valid) {
      return;
   }
   // Nothing of the session is released: stopping the subscription would unregister the parent's subscription, and
   // closing the connection would end the parent's session (the child shares its network connection) or wait for a
   // reply that the parent can read; freeing the Oracle client's handles can need a lock that a thread of the parent
   // held when the process was created.  The memory is released with the process.
   m_tname->deref();
   m_qname->deref();
   m_enqueue = nullptr;
   m_dequeue = nullptr;
   m_typeInfo = nullptr;
   m_conn = nullptr;
   m_ds = nullptr;
   m_tname = nullptr;
   m_qname = nullptr;
   m_hasSubscription = false;
   valid = false;
}

int AQQueuePriv::checkProcess(const char* m, ExceptionSink* xsink) const {
   if (isForkedChild()) {
      xsink->raiseException("AQQUEUE-FORK-ERROR", "the AQQueue::%s() method cannot be called in a child process "
         "created with fork() after the object was created: the queue's session and subscription belong to process "
         "%d", m, static_cast<int>(m_pid));
      return -1;
   }
   return 0;
}

void AQQueuePriv::destructorUnlocked(ExceptionSink *xsink) {
   // the object is also destroyed when a connection is made and the queue's type cannot be found (see
   // connectUnlocked()), which can happen when a lost subscription is restored; the destructor then has nothing
   // left to do
   if (!valid) {
      return;
   }

   disconnectUnlocked(xsink);
   m_tname->deref();
   m_qname->deref();
   m_ds->close();
   delete m_ds;
#ifdef DEBUG
   m_tname = 0;
   m_qname = 0;
   m_ds = 0;
#endif

   valid = false;
}

int AQQueuePriv::reconnectUnlocked(ExceptionSink* xsink) {
   if (m_hasSubscription) {
      if (reconnectSubscriptionUnlocked(xsink)) {
         endSubscriptionUnlocked();
         aqSubscriptionManager.remove(this);
         return -1;
      }
      return 0;
   }

   {
      // the connection is lost: errors closing it are expected and ignored
      ExceptionSink lost_xsink;
      disconnectUnlocked(&lost_xsink);
      lost_xsink.clear();
   }
   return connectUnlocked(xsink);
}

int AQQueuePriv::reconnectSubscriptionUnlocked(ExceptionSink* xsink) {
   {
      // the connection is lost: errors stopping the subscription and closing the connection are expected and
      // ignored; the subscription keeps its callback thread, as it is restored below
      ExceptionSink lost_xsink;
      stopSubscriptionUnlocked(&lost_xsink, false);
      disconnectUnlocked(&lost_xsink);
      lost_xsink.clear();
   }

   //printd(5, "AQQueuePriv::reconnectSubscriptionUnlocked() disconnected()\n");

   if (connectUnlocked(xsink))
      return -1;

   //printd(5, "AQQueuePriv::reconnectSubscriptionUnlocked() reconnected()\n");

   if (!checkDequeueUnlocked(qoreObject(), xsink))
      return -1;

   if (!OCI_DequeueSubscribe(&m_conn->ocilib, m_dequeue, m_port, m_timeout, on_async_message, xsink))
      return -1;

   m_hasSubscription = true;

   //printd(5, "AQQueuePriv::reconnectSubscriptionUnlocked() resubscribed()\n");
   return 0;
}

void AQQueuePriv::disconnect(ExceptionSink* xsink) {
   AutoLocker al(l);
   disconnectUnlocked(xsink);
}

void AQQueuePriv::disconnectUnlocked(ExceptionSink* xsink) {
   //printd(5, "AQQueuePriv::disconnectUnlocked() this: %p m_dequeue: %p hasSubscription: %d\n", this, m_dequeue, m_hasSubscription);
   if (m_enqueue) {
      OCI_EnqueueFree(&m_conn->ocilib, m_enqueue);
      m_enqueue = 0;
   }
   if (m_dequeue) {
      if (m_hasSubscription) {
         aqSubscriptionManager.remove(this);
         stopSubscriptionUnlocked(xsink, true);
      }
      OCI_DequeueFree(&m_conn->ocilib, m_dequeue, xsink);
      m_dequeue = 0;
   }
   if (m_typeInfo) {
      OCI_TypeInfoFree2(&m_conn->ocilib, m_typeInfo);
      m_typeInfo = 0;
   }

   m_ds->close();
   m_conn = 0;
   //m_conn->logoff();
}

void AQQueuePriv::connect(ExceptionSink *xsink) {
   AutoLocker al(l);
   disconnectUnlocked(xsink);
   connectUnlocked(xsink);
}

int AQQueuePriv::connectUnlocked(ExceptionSink *xsink) {
   assert(!m_conn);

   if (m_ds->open(xsink)) {
      //printd(5, "AQQueuePriv::connectUnlocked() this: %p open failed\n", this);
      return -1;
   }
   m_conn = m_ds->getPrivateData<QoreOracleConnection>();

   //printd(5, "AQQueuePriv::connectUnlocked() this: %p qe: %p (%s)\n", this, m_conn->ds.getQoreEncoding(), m_conn->ds.getQoreEncoding()->getCode());

   // can only call Datasource::getQoreEncoding() after the call to Datasource::open()
   TempEncodingHelper tn(m_tname, m_conn->ds.getQoreEncoding(), xsink);
   if (*xsink)
      return -1;

   TempEncodingHelper qn(m_qname, m_conn->ds.getQoreEncoding(), xsink);
   if (*xsink)
      return -1;

   // use QoreString instead of a fixed-size buffer to deal with arbitrary-length strings
   QoreStringMaker value("Qore AQ Queue: %s", qn->getBuffer());
   OCI_SetTrace(&m_conn->ocilib, m_conn->ocilib_cn, OCI_TRC_MODULE, value.getBuffer(), xsink);
   if (*xsink)
      return -1;

   assert(!m_typeInfo);
   m_typeInfo = OCI_TypeInfoGet2(&m_conn->ocilib, m_conn->ocilib_cn, tn->getBuffer(), OCI_TIF_TYPE, xsink);

   if (!m_typeInfo) {
      if (!*xsink)
         xsink->raiseException("AQ-MESSAGE-ERROR", "Cannot get type info for '%s'", m_tname->getBuffer());
      destructorUnlocked(xsink);
      return -1;
   }

   return 0;
}

bool AQQueuePriv::pingUnlocked() {
   // a failed ping means that the connection is lost; the error itself is not needed
   ExceptionSink xsink;
   bool rv = OCI_Ping(&m_conn->ocilib, m_conn->ocilib_cn, &xsink);
   xsink.clear();
   return rv;
}

int AQQueuePriv::checkValidUnlocked(const char* m, ExceptionSink* xsink) {
   if (!valid) {
       xsink->raiseException("AQQUEUE-ERROR", "the AQQueue::%s() method cannot be executed because the AQQueue object has already been deleted in another thread", m);
      return -1;
   }
   if (!m_conn && connectUnlocked(xsink))
      return -1;

   return 0;
}

bool AQQueuePriv::post(AQMessagePriv *message, ExceptionSink *xsink) {
   // checked before the lock, which the parent's watchdog thread can have held when the process was created
   if (checkProcess("post", xsink))
      return false;
   AutoLocker al(l);
   if (checkValidUnlocked("post", xsink))
      return false;

    if (!m_enqueue) {
       //printd(5, "Opening W queue: %s (%p)\n", m_qname->getBuffer(), m_typeInfo);
       m_enqueue = OCI_EnqueueCreate(&m_conn->ocilib, m_typeInfo, m_qname->getBuffer());
       if (!m_enqueue) {
          xsink->raiseException("AQQUEUE-ERROR", "failed to initialize queue");
          return false;
       }
    }

    ReferenceHolder<QoreHashNode> obj(message->getObject(), xsink);
    if (!obj) {
        xsink->raiseException("AQQUEUE-ERROR", "no oracle object (hash) provided in the message");
        return false;
    }

    OCI_Object *o = objBindQore(m_conn, *obj, xsink);
    if (!o) {
       xsink->raiseException("AQQUEUE-ERROR", "failed to create(bind) object");
       return false;
    }
    ON_BLOCK_EXIT(OCI_ObjectFree2, &m_conn->ocilib, o, xsink);

    OCI_Msg *m = OCI_MsgCreate(&m_conn->ocilib, m_typeInfo, xsink);
    if (!m) {
       if (!*xsink)
          xsink->raiseException("AQQUEUE-ERROR", "cannot allocate message object");
       return false;
    }
    ON_BLOCK_EXIT(OCI_MsgFree, &m_conn->ocilib, m, xsink);

    if (!OCI_MsgSetObject(&m_conn->ocilib, m, o, xsink)) {
       if (!*xsink)
          xsink->raiseException("AQQUEUE-ERROR", "cannot set message object");
       return false;
    }

    if (!OCI_MsgSetEnqueueDelay(&m_conn->ocilib, m, message->getEnqueueDelay(), xsink)) {
       if (!*xsink)
          xsink->raiseException("AQQUEUE-ERROR", "failed to set message delay");
       return false;
    }
    if (!OCI_MsgSetExpiration(&m_conn->ocilib, m, message->getExpiration(), xsink)) {
       if (!*xsink)
          xsink->raiseException("AQQUEUE-ERROR", "failed to set expiration");
       return false;
    }
    if (!OCI_MsgSetPriority(&m_conn->ocilib, m, message->getPriority(), xsink)) {
       if (!*xsink)
          xsink->raiseException("AQQUEUE-ERROR", "failed to set priority");
       return false;
    }

    QoreStringNodeHolder correlation(message->getCorrelation());

    if (*correlation) {
        TempEncodingHelper encoded(*correlation, m_conn->ds.getQoreEncoding(), xsink);
        if (*xsink)
           return false;
        if (!OCI_MsgSetCorrelation(&m_conn->ocilib, m, encoded->getBuffer(), xsink)) {
           if (!*xsink)
              xsink->raiseException("AQQUEUE-ERROR", "failed to set correlation");
           return false;
        }
    }

    if (!OCI_EnqueuePut(&m_conn->ocilib, m_enqueue, m, xsink)) {
        if (*xsink)
            return false;
    }

    return true;
}

bool AQQueuePriv::post(const QoreHashNode *h, ExceptionSink *xsink) {
   // checked before the lock, which the parent's watchdog thread can have held when the process was created
   if (checkProcess("post", xsink))
      return false;
   AutoLocker al(l);
   if (checkValidUnlocked("post", xsink))
      return false;

   if (!m_enqueue) {
      //printd(5, "Opening W queue: %s (%p)\n", m_qname->getBuffer(), m_typeInfo);
      m_enqueue = OCI_EnqueueCreate(&m_conn->ocilib, m_typeInfo, m_qname->getBuffer());
      if (!m_enqueue) {
         xsink->raiseException("AQQUEUE-ERROR", "failed to initialize queue");
         return false;
      }
   }

   OCI_Object* obj = objBindQore(m_conn, h, xsink);
   if (!obj) {
      xsink->raiseException("AQQUEUE-ERROR", "failed to create(bind) object");
      return false;
   }
   ON_BLOCK_EXIT(OCI_ObjectFree2, &m_conn->ocilib, obj, xsink);

   OCI_Msg* msg = OCI_MsgCreate(&m_conn->ocilib, m_typeInfo, xsink);
   if (!msg) {
      if (!*xsink)
         xsink->raiseException("AQQUEUE-ERROR", "cannot allocate message");
      return false;
   }
   ON_BLOCK_EXIT(OCI_MsgFree, &m_conn->ocilib, msg, xsink);

   if (!OCI_MsgSetObject(&m_conn->ocilib, msg, obj, xsink)) {
      if (!*xsink)
         xsink->raiseException("AQQUEUE-ERROR", "cannot set message object");
      return false;
   }

   if (!OCI_EnqueuePut(&m_conn->ocilib, m_enqueue, msg, xsink)) {
       if (*xsink)
           return false;
   }

   return true;
}

bool AQQueuePriv::commit(ExceptionSink *xsink) {
   // checked before the lock, which the parent's watchdog thread can have held when the process was created
   if (checkProcess("commit", xsink))
      return false;
   AutoLocker al(l);
   if (checkValidUnlocked("commit", xsink))
      return false;

   return m_conn->commit(xsink);
}

bool AQQueuePriv::rollback(ExceptionSink *xsink) {
   // checked before the lock, which the parent's watchdog thread can have held when the process was created
   if (checkProcess("rollback", xsink))
      return false;
   AutoLocker al(l);
   if (checkValidUnlocked("rollback", xsink))
      return false;

   return m_conn->rollback(xsink);
}

QoreObject* AQQueuePriv::getMessage(QoreObject* self, int timeout, ExceptionSink *xsink) {
   // checked before the lock, which the parent's watchdog thread can have held when the process was created
   if (checkProcess("getMessage", xsink))
      return 0;
   AutoLocker al(l);
   if (checkValidUnlocked("getMessage", xsink))
      return 0;

   if (!checkDequeueUnlocked(self, xsink))
      return 0;

   //printd(5, "AQQueuePriv::getMessage() this: %p dequeue: %p msg: %p msg->typinfo: %p (%s)\n", this, m_dequeue, m_dequeue->msg, m_dequeue->msg->typinf, m_dequeue->msg->typinf->name);

   // set timeout if necessary
   if (!OCI_DequeueSetWaitTime(&m_conn->ocilib, m_dequeue, timeout, xsink)) {
      if (!*xsink)
         xsink->raiseException("AQQUEUE-ERROR", "failed to set dequeue timeout of %d second%s", timeout, timeout == 1 ? "" : "s");
      return 0;
   }

   OCI_Msg *msg;

   while (true) {
      //printd(5, "AQQueuePriv::getMessage() this: %p calling OCI_DequeueGet()\n");
      msg = OCI_DequeueGet(&m_conn->ocilib, m_dequeue, xsink);
      //printd(5, "AQQueuePriv::getMessage() this: %p msg: %p xsink: %d\n", this, msg, (bool)*xsink);

      if (msg == NULL) {
         if (*xsink) {
            // try to reconnect if connection was lost
            if (!pingUnlocked()) {
               printd(5, "AQQueuePriv::getMessage(): this: %p connection lost, reconnecting...\n", this);
               // use a temporary empty ExceptionSink object for the reconnect
               ExceptionSink tmp;
               // try to reconnect if possible
               if (reconnectUnlocked(&tmp)) {
                  xsink->assimilate(tmp);
                  return 0;
               }
               xsink->clear();
               // recreate dequeue object from new connection
               if (!checkDequeueUnlocked(self, xsink))
                  return 0;
               // we've successfully reconnected; now try again
               continue;
            }
         }

         //printd(5, "AQQueuePriv::getMessage() this: %p Message is NULL. NOTHING returned.\n", this);
         return 0;
      }
      break;
   }

   OCI_Object *o = OCI_MsgGetObject(&m_conn->ocilib, msg);

   if (!o) {
      printd(5, "AQQueuePriv::getMessage() object in message is NULL\n");
      return 0;
   }

   ON_BLOCK_EXIT(OCI_ObjectFree2, &m_conn->ocilib, o, xsink);

    ReferenceHolder<> obj(objToQore(m_conn, o, xsink), xsink);
    if (!obj) {
       xsink->raiseException("AQQUEUE-ERROR", "Cannot get qore hash from OCI object");
       return 0;
    }
    assert(obj->getType() == NT_HASH);

    AQMessagePriv *qop = new AQMessagePriv(reinterpret_cast<QoreHashNode*>(*obj), xsink);
    QoreObject *qo = new QoreObject(QC_AQMESSAGE, getProgram(), qop);
    printd(5, "AQQueuePriv::getMessage() this: %p returning obj: %p\n", this, qo);
    return qo;
}

bool AQQueuePriv::checkDequeueUnlocked(QoreObject* self, ExceptionSink *xsink) {
   if (!m_dequeue) {
      //printd(5, "AQQueuePriv::checkDequeueUnlocked() this: %p Opening R queue: %s (%p)\n", this, m_qname->getBuffer(), m_typeInfo);
      m_dequeue = OCI_DequeueCreate(&m_conn->ocilib, m_typeInfo, m_qname->getBuffer(), xsink);
      if (!m_dequeue) {
         if (!*xsink)
            xsink->raiseException("AQQUEUE-ERROR", "failed to initialize queue");
         return false;
      }
      // the subscription callback finds the object and its sandbox through the private data
      m_dequeue->user_ctx = (void*)this;
      //printd(5, "AQQueuePriv::checkDequeueUnlocked() this: %p DEQUEUE ptr: %p msg: %p m_typeInfo: %p msg->typinfo: %p (%s)\n", this, m_dequeue, m_dequeue->msg, m_typeInfo, m_dequeue->msg->typinf, m_dequeue->msg->typinf->name);
   }
   return true;
   // TODO
   //OCI_DequeueSetConsumer for list
}

std::shared_ptr<const QoreSandboxCapture> AQQueuePriv::getSandbox() const {
   std::lock_guard<std::mutex> sl(m_sandbox_lock);
   return m_sandbox;
}

void AQQueuePriv::checkSubscription() {
   std::shared_ptr<const QoreSandboxCapture> sandbox = getSandbox();
   if (!sandbox) {
      return;
   }
   // the check, the reconnection and onSubscriptionLost() run under the sandbox of the code that started the
   // subscription
   QoreSandboxCaptureHelper sch(*sandbox);

   // errors restoring the subscription are reported when the sink goes out of scope
   ExceptionSink xsink;
   {
      // a queue that another thread is using is not checked now: its connection is in use, and the watchdog must
      // not wait for it (a dequeue can wait without a time limit)
      if (l.trylock()) {
         return;
      }
      ON_BLOCK_EXIT_OBJ(l, &QoreThreadLock::unlock);

      if (!valid || !m_hasSubscription || !m_conn || pingUnlocked()) {
         return;
      }

      printd(5, "AQQueuePriv::checkSubscription() connection lost, restoring subscription: %p\n", this);
      if (!reconnectSubscriptionUnlocked(&xsink)) {
         return;
      }

      // the subscription cannot be restored: it is no longer watched
      aqSubscriptionManager.remove(this);
      endSubscriptionUnlocked();
      // the object is called later without the lock; a weak reference keeps it valid until then
      m_self->tRef();
      QoreObject* prev = m_lost.exchange(m_self);
      if (prev) {
         // a loss that has not been reported yet is reported once
         prev->tDeref();
      }
   }

   // the subscription is reported lost on the dispatch thread, outside this thread's OCI processing (see
   // AQCallbackDispatcher), without any lock held, so that onSubscriptionLost() can restart it
   ref();
   if (aqCallbackDispatcher.post(AQCallbackDispatcher::Kind::SubscriptionLost, this)) {
      // the dispatch thread cannot be started: the loss is reported here
      notifySubscriptionLost();
      deref();
   }
}

void AQQueuePriv::notifySubscriptionLost() {
   // the queue's lock is not needed: another thread can use the queue for a long time (getMessage() can wait without a
   // time limit)
   QoreObject* obj = m_lost.exchange(nullptr);
   if (!obj) {
      return;
   }
   std::shared_ptr<const QoreSandboxCapture> sandbox = getSandbox();
   assert(sandbox);
   {
      // onSubscriptionLost() runs under the sandbox of the code that started the subscription
      QoreSandboxCaptureHelper sch(*sandbox);
      // an exception that the method raises is reported when the sink goes out of scope
      ExceptionSink xsink;
      obj->evalMethod("onSubscriptionLost", 0, &xsink);
   }
   obj->tDeref();
}

void AQQueuePriv::postAsyncMessage() {
   QoreObject* obj;
   uint64_t subscription;
   {
      std::lock_guard<std::mutex> sl(m_sandbox_lock);
      obj = m_self;
      subscription = m_subscription;
   }
   if (!subscription) {
      // the subscription has been stopped
      return;
   }
   assert(obj);
   ref();
   obj->tRef();
   if (aqCallbackDispatcher.post(AQCallbackDispatcher::Kind::AsyncMessage, this, obj, subscription)) {
      // the dispatch thread cannot be started: the callback is made here, on the notification thread
      QoreForeignThreadHelper qfth(aqCallbackThreadManager.getTid());
      deliverAsyncMessage(obj, subscription);
      obj->tDeref();
      deref();
   }
}

void AQQueuePriv::deliverAsyncMessage(QoreObject* obj, uint64_t subscription) {
   std::shared_ptr<const QoreSandboxCapture> sandbox;
   {
      std::lock_guard<std::mutex> sl(m_sandbox_lock);
      if (m_subscription != subscription) {
         // the subscription was stopped after the notification was queued
         return;
      }
      sandbox = m_sandbox;
   }
   assert(sandbox);
   // the callback runs under the sandbox of the code that started the subscription
   QoreSandboxCaptureHelper sch(*sandbox);
   // an exception that the method raises is reported when the sink goes out of scope
   ExceptionSink xsink;
   obj->evalMethod("onAsyncMessage", 0, &xsink);
}

void AQQueuePriv::endSubscriptionUnlocked() {
   {
      std::lock_guard<std::mutex> sl(m_sandbox_lock);
      m_subscription = 0;
   }
   aqCallbackThreadManager.dec();
}

#ifdef DEBUG
QoreValue AQQueuePriv::dbgWithLock(const ResolvedCallReferenceNode* code, ExceptionSink* xsink) {
   AutoLocker al(l);
   return code->execValue(nullptr, xsink);
}

QoreValue aq_dbg_with_queue_lock(const QoreListNode* args, RuntimeConfig& rc, ExceptionSink* xsink) {
   QoreObject* obj = get_param_value(args, 0).get<QoreObject>();
   const ResolvedCallReferenceNode* code = get_param_value(args, 1).get<const ResolvedCallReferenceNode>();
   PrivateDataRefHolder<AQQueuePriv> priv(obj, CID_AQQUEUE, xsink);
   if (!priv) {
      return QoreValue();
   }
   return priv->dbgWithLock(code, xsink);
}
#endif

void AQQueuePriv::startSubscription(QoreObject* self, unsigned port, int64 timeout, ExceptionSink *xsink) {
   // checked before the lock, which the parent's watchdog thread can have held when the process was created
   if (checkProcess("startSubscription", xsink))
      return;
   AutoLocker al(l);
   if (checkValidUnlocked("startSubscription", xsink))
      return;

   {
      // m_self is read by the Oracle client's notification thread with the subscription (see postAsyncMessage())
      std::lock_guard<std::mutex> sl(m_sandbox_lock);
      m_self = self;
   }

   if (!checkDequeueUnlocked(self, xsink))
      return;

   if (m_hasSubscription) {
      xsink->raiseException("AQQUEUE-ERROR", "a subscription is already set with this AQQueue object; call AQQueue::stopSubscription() first before calling AQQueue::startSubscription()");
      return;
   }

   //printd(5, "AQQueuePriv::startSubscription() this: %p dequeue: %p self: %p port: %zd timeout: %zd\n", this, m_dequeue, self, port, timeout);

   {
      pid_t listener_pid = aq_notification_pid.load(std::memory_order_relaxed);
      if (listener_pid && listener_pid != getpid()) {
         xsink->raiseException("AQQUEUE-FORK-ERROR", "AQQueue::startSubscription() cannot be called in a child "
            "process created with fork() after process %d started a subscription: the Oracle client's notification "
            "listener remains in that process", static_cast<int>(listener_pid));
         return;
      }
   }

   // increment "oracle-thread active" count
   aqCallbackThreadManager.inc();

   // the callbacks of the subscription run under the sandbox of the code that starts it, and the notifications are
   // delivered for its identifier; both are set before the subscription is registered, so that they are there for the
   // first notification
   {
      std::lock_guard<std::mutex> sl(m_sandbox_lock);
      m_sandbox = std::make_shared<const QoreSandboxCapture>();
      m_subscription = ++aq_last_subscription;
   }

   if (!OCI_DequeueSubscribe(&m_conn->ocilib, m_dequeue, port, timeout, on_async_message, xsink)) {
      endSubscriptionUnlocked();
      if (!*xsink)
         xsink->raiseException("AQQUEUE-ERROR", "unknown error starting the subscription");
      return;
   }

   // the Oracle client's notification listener now serves this process
   {
      pid_t none = 0;
      aq_notification_pid.compare_exchange_strong(none, getpid(), std::memory_order_relaxed);
   }

   m_hasSubscription = true;
   m_port = port;
   m_timeout = timeout;

   if (aqSubscriptionManager.add(this, xsink)) {
      stopSubscriptionUnlocked(xsink, true);
      return;
   }

   //printd(5, "AQQueuePriv::startSubscription() this: %p dequeue: %p self: %p callback: %p\n", this, m_dequeue, self, m_dequeue->callback);
}

int AQQueuePriv::stopSubscriptionUnlocked(ExceptionSink *xsink, bool release_callback_thread) {
   //printd(5, "AQQueuePriv::stopSubscriptionUnlocked() this: %p xsink: %p\n", this, xsink);

   assert(xsink);
   assert(m_dequeue);
   assert(m_hasSubscription);

   if (release_callback_thread) {
      // no notification that has not been delivered yet is delivered from now on (see deliverAsyncMessage())
      std::lock_guard<std::mutex> sl(m_sandbox_lock);
      m_subscription = 0;
   }
   bool b = OCI_DequeueUnsubscribe(&m_conn->ocilib, m_dequeue, xsink);
   if (release_callback_thread) {
      aqCallbackThreadManager.dec();
   }
   m_hasSubscription = false;

   if (!b) {
      if (!*xsink) {
         xsink->raiseException("AQQUEUE-ERROR", "unknown error stopping the subscription");
      }
      return -1;
   }

   return 0;
}

int AQQueuePriv::stopSubscription(ExceptionSink *xsink) {
   // checked before the lock, which the parent's watchdog thread can have held when the process was created
   if (checkProcess("stopSubscription", xsink))
      return -1;
   AutoLocker al(l);
   if (checkValidUnlocked("stopSubscription", xsink))
      return false;

   //printd(5, "AQQueuePriv::stopSubscription() this: %p m_dequeue: %p m_hasSubscription: %d\n", this, m_dequeue, (int)m_hasSubscription);

   if (!m_hasSubscription)
      return 0;

   aqSubscriptionManager.remove(this);
   stopSubscriptionUnlocked(xsink, true);

   return 0;
}

static int ds_set_options(Datasource& ds, const QoreHashNode* opts, ExceptionSink* xsink) {
   ConstHashIterator hi(opts);
   while (hi.next()) {
      // skip "min" and "max" options
      if (!strcmp(hi.getKey(), "min") || !strcmp(hi.getKey(), "max"))
         continue;

      if (ds.setOption(hi.getKey(), hi.get(), xsink))
         return -1;
   }
   return 0;
}

static void aqqueue_constructor_hash(const QoreStringNode* queueName, const QoreStringNode* typeName, const QoreHashNode* opts, QoreObject* self, ExceptionSink* xsink) {
    static const char *DSC_ERR = "AQQUEUE-CONSTRUCTOR-ERROR";

    std::string str;
    bool has_str = check_hash_key(opts, "type", DSC_ERR, str, xsink);
    if (*xsink) return;

    if (has_str && str != "oracle") {
        xsink->raiseException(DSC_ERR, "if the 'type' key is present, then it must be 'oracle'; value provided: '%s'",
            str.c_str());
        return;
    }

    DBIDriver *db_driver = DBI.find("oracle", xsink);
    // driver must be laoded because it's being executed now :)
    assert(db_driver);

    std::unique_ptr<Datasource> ds(new Datasource(db_driver));

    has_str = check_hash_key(opts, "user", DSC_ERR, str, xsink);
    if (*xsink) return;
    if (has_str) ds->setPendingUsername(str.c_str());

    has_str = check_hash_key(opts, "pass", DSC_ERR, str, xsink);
    if (*xsink) return;
    if (has_str) ds->setPendingPassword(str.c_str());

    has_str = check_hash_key(opts, "db", DSC_ERR, str, xsink);
    if (*xsink) return;
    if (has_str) ds->setPendingDBName(str.c_str());

    has_str = check_hash_key(opts, "charset", DSC_ERR, str, xsink);
    if (*xsink) return;
    if (has_str) ds->setPendingDBEncoding(str.c_str());

    has_str = check_hash_key(opts, "host", DSC_ERR, str, xsink);
    if (*xsink) return;
    if (has_str) ds->setPendingHostName(str.c_str());

    bool found;
    int port = (int)opts->getKeyAsBigInt("port", found);
    if (port) {
        if (port < 0) {
            xsink->raiseException(DSC_ERR, "port value must be zero (meaning use the default port) or positive (value given: %d)", port);
            return;
        }

        ds->setPendingPort(port);
    }

    {
        QoreValue p = opts->getKeyValue("options");

        if (!p.isNothing()) {
            if (p.getType() != NT_HASH) {
                xsink->raiseException(DSC_ERR, "'options' key is not type 'hash' but is type '%s'", p.getTypeName());
                return;
            }
            const QoreHashNode* oh = p.get<const QoreHashNode>();
            if (ds_set_options(*ds.get(), oh, xsink))
                return;
        }
    }

    ds->open(xsink);
    if (*xsink) {
        return;
    }

    self->setPrivate(CID_AQQUEUE, new AQQueuePriv(ds.release(), typeName, queueName, xsink));
}

//! Implementation of AQ Queue.
/**
 * AQ messages notification with Oracle Client 10gR2 or above
 *
 * When a subscription is active (see @ref AQQueue::startSubscription()), @ref AQQueue::onAsyncMessage() is called
 * for each notification of the Oracle client, and a background watchdog thread checks the connection of every
 * subscription every 25 seconds and restores lost subscriptions; when a subscription cannot be restored,
 * @ref AQQueue::onSubscriptionLost() is called, so that it can restart the subscription.  Both callbacks are called
 * on a background callback thread of the module, one at a time: the Oracle client's notification thread only hands
 * each notification to that thread, so that no lock of the Oracle client is held while
 * @ref AQQueue::onAsyncMessage() runs (the client takes the same lock to start a subscription).  These
 * threads serve the subscriptions of all objects; each callback, and each reconnection made for a subscription, runs
 * under the sandbox (\c Qore::SandboxManager) of the code that called @ref AQQueue::startSubscription(), so it can
 * never do more than that code.
 *
 * An AQQueue object cannot be used in a child process created with \c fork() after it was created: its session and
 * subscription belong to the parent, and every method raises \c AQQUEUE-FORK-ERROR in the child; when the child
 * destroys the object, the session and the subscription are abandoned without changing the parent's (see
 * @ref fork_issues).
 */
qclass AQQueue [dom=DATABASE; arg=AQQueuePriv* priv; ns=Qore::Oracle];

//! Construct a queue object for posting/getting messages from a datasource description string
/** @param queueName a mandatory name of the queue in the database
    @param typeName a mandatory name of the type for this queue in the DB
    @param desc a datasource description string in the format that can be parsed by parse_datasource()

    @throw AQQUEUE-CONSTRUCTOR-ERROR invalid arguments to constructor
    @throw DBI-OPTION-ERROR unknown or unsupported option passed to the Oracle driver
 */
AQQueue::constructor(string queueName, string typeName, string desc) {
   ReferenceHolder<QoreHashNode> h(parseDatasource(desc->getBuffer(), xsink), xsink);
   if (!h) {
      assert(*xsink);
      return;
   }
   aqqueue_constructor_hash(queueName, typeName, *h, self, xsink);
   return;
}

//! Construct a queue object for posting/getting messages.
/** @param queueName a mandatory name of the queue in the database
    @param typeName a mandatory name of the type for this queue in the DB
    @param opts a hash giving parameters for the new dedicated connection to the Oracle database server with the following possible keys (the \c "type" key is optional, but if present, must be \c "oracle"):
    - \c type: (@ref string_or_nothing_type "*string") The name of the database driver to use; this key is optional, but if present must be \c "oracle" or an exception will be raised
    - \c user: (@ref string "string") The user name for the new connection
    - \c pass: (@ref string "string") The password for the new connection
    - \c db: (@ref string "string") The database name for the new connection
    - \c charset: (@ref string_or_nothing_type "*string") The Oracle-specific name of the character encoding to use for the new connection. If no value is passed for this parameter, then the Oracle character encoding corresponding to the default character encoding for the %Qore process will be used instead.
    - \c host: (@ref string_or_nothing_type "*string") The host name for the new connection
    - \c port: (@ref softint_type "softint") The port number for the new connection. If this key is present and is 0 then an exception will be raised.
    - \c options: (@ref hash_or_nothing_type "*hash") Any options for the new connection

    @throw AQQUEUE-CONSTRUCTOR-ERROR invalid arguments to constructor
    @throw DBI-OPTION-ERROR unknown or unsupported option passed to the Oracle driver
 */
AQQueue::constructor(string queueName, string typeName, hash opts) {
   aqqueue_constructor_hash(queueName, typeName, opts, self, xsink);
}

//! stops any active subscriptions and destroys the object
/**
 */
AQQueue::destructor() {
   priv->destructor(xsink);
   priv->deref();
}

//! Copying objects of this class is not supported, an exception will be thrown
/**
    @throw AQQUEUE-COPY-ERROR copying AQQueue objects is not yet supported
 */
AQQueue::copy() {
   xsink->raiseException("AQQUEUE-COPY-ERROR", "copying AQQueue objects is currently not supported");
}

//! Post the AQMessage into the queue.
/** @param msg a AQMessage instance
 *
 * @throw AQQUEUE-FORK-ERROR the object was created by another process (this is a child process created with
 * \c fork())
 */
nothing AQQueue::post(AQMessage[AQMessagePriv] msg) {
    priv->post(*msg, xsink);
}

//! Post the plain Oracle object hash into the queue.
/** @param msg a qore hash (Oracle object)
 *
 * The hash/object will use default message properties. Use post() with an
 * AQMessage instance if you need to modify the message defaults.
 *
 * @throw AQQUEUE-FORK-ERROR the object was created by another process (this is a child process created with
 * \c fork())
 */
nothing AQQueue::post(hash msg) {
   priv->post(msg, xsink);
}

//! Get message from queue
/** @param timeout the timeout in seconds; 0 = no timeout

    @retval AQMessage or NOTHING if no message was available in the timeout period

    @throw AQQUEUE-FORK-ERROR the object was created by another process (this is a child process created with
    \c fork())
 */
*AQMessage AQQueue::getMessage(softint timeout = 0) {
   return priv->getMessage(self, timeout, xsink);
}

//! Subscribe for asynchronous messages notifications
/** @ref AQQueue::onAsyncMessage() and @ref AQQueue::onSubscriptionLost() are called for the subscription on the
    module's callback thread, under the sandbox of the code that calls this method

    @param port an optional non-negative port number (0 = use the default port)
    @param timeout an optional timeout value in seconds; any positive value in seconds is valid. The value 0 is accepted and means that it does not wait for messages and returns immediately if no messages are available.  The value -1 is accepted and means it waits for ever (until a message is available in the queue)

    @throw AQQUEUE-ERROR port or timeout value invalid; subscription already active for this object
    @throw AQQUEUE-FORK-ERROR this is a child process created with \c fork() after its parent or an ancestor started
    a subscription (see @ref fork_issues)
    @throw AQQUEUE-FORK-ERROR the object was created by another process (this is a child process created with
    \c fork())
 */
nothing AQQueue::startSubscription(int port = 0, int timeout = 0) {
   if (port < 0) {
      xsink->raiseException("AQQUEUE-ERROR", "Port number has to be greater than or equal to 0");
      return QoreValue();
   }

   if (timeout < -1) {
      xsink->raiseException("AQQUEUE-ERROR", "Timeout value has to be greater than or equal to -1");
      return QoreValue();
   }

   priv->startSubscription(self, (unsigned)port, timeout, xsink);
}

//! Unsubscribe for asynchronous messages notifications.
/** If no subscription is active, no action is taken.

    No notification of the subscription that has not been delivered yet is delivered once the subscription is
    stopped; a call of @ref AQQueue::onAsyncMessage() that is already running on the module's callback thread is not
    interrupted.

    @throw AQQUEUE-ERROR oracle error stopping the subscription
    @throw AQQUEUE-FORK-ERROR the object was created by another process (this is a child process created with
    \c fork())
 */
nothing AQQueue::stopSubscription() {
   priv->stopSubscription(xsink);
}

//! Commit the transaction.
/** Confirm all posted or fetched messages.

    @throw AQQUEUE-FORK-ERROR the object was created by another process (this is a child process created with
    \c fork())
 */
bool AQQueue::commit() {
    return priv->commit(xsink);
}

//! Rollback the transaction.
/** Rollback all posted or fetched messages.

    @throw AQQUEUE-FORK-ERROR the object was created by another process (this is a child process created with
    \c fork())
 */
bool AQQueue::rollback() {
    return priv->rollback(xsink);
}

//! Automatically called when a new message is received on the queue when there is an active subscription
/** A method which is called when there is a new message in the queue.  It is called on the module's callback thread,
    which makes the callbacks of all subscriptions one at a time, under the sandbox of the code that started the
    subscription.

    The default implementation throws an exception; this method must be overridden in subclasses to receive messages;
    use the @ref AQQueue::getMessage() method to receive the message

    @throw AQQUEUE-ONASYNCMESSAGE-ERROR abstract implementation of AQQueue::onAsyncMessage called
 */
nothing AQQueue::onAsyncMessage() {
   xsink->raiseException("AQQUEUE-ONASYNCMESSAGE-ERROR", "abstract implementation of AQQueue::onAsyncMessage called");
}

//! Automatically called when the connection is externally disconnected
/** A method which is called when there is a subscription but the periodical check for a live connection fails and
    the subscription cannot be restored.  It is called on the module's callback thread, after the subscription has
    been removed from the periodical check.

    The default implementation does nothing; override this method in subclasses to be notified; the method can call
    @ref AQQueue::startSubscription() to restore the subscription, for example
 */
nothing AQQueue::onSubscriptionLost() {
   //xsink->raiseException("AQQUEUE-ONSUBSCRIPTIONLOST-ERROR", "abstract implementation of AQQueue::onAsyncMessage called");
}
