#include "oracle.h"
#include "oracle-module.h"

//! Oracle session attributes reported in \c V$SESSION for the statements executed by a thread
/** All values are optional; a missing or empty value is reported as \c NULL.  Values longer than 64 bytes are
    truncated on a character boundary.

    @see
    - @ref Qore::Oracle::setThreadSessionInfo() "setThreadSessionInfo()"
    - @ref Qore::Oracle::getThreadSessionInfo() "getThreadSessionInfo()"
    - @ref oracleora_thread_session_infoguide

    @since oracle 3.4.1
*/
hashdecl Qore::Oracle::OracleSessionInfo {
    //! the \c MODULE column of \c V$SESSION: the name of the module currently running
    *string module;

    //! the \c ACTION column of \c V$SESSION: the action within the current module
    *string action;

    //! the \c CLIENT_INFO column of \c V$SESSION: information about the client application
    *string client_info;

    //! the \c CLIENT_IDENTIFIER column of \c V$SESSION: the end user or context the session works for
    *string client_identifier;
}

/** @defgroup oracle_functions Oracle Functions
 */
///@{
namespace Qore::Oracle;

//! returns a value to be used to bind a Qore value as an "IN OUT" variable for PL/SQL
/** @param value any Qore variable
    @param type an optional parameter to enforce the type of the variable. It is obtained automatically fromn the \c value when it is omitted.

    @return a has which can be used for IN OUT binding. Keys:
    - \c "type" : a string type name of the variable (if it is provided as an argument)
    - \c "value" : a variable/value itself

    @par Example:
    @code
my string $str = "lorem ipsum";
my int $i = 10;
my date $d = now();

my hash $res = $ds.exec("begin qore_test.do_simple_inout(:ostr, :oint, :odt); end;",
                        Oracle::bindInOut($str),
                        Oracle::bindInOut($i),
                        Oracle::bindInOut($d)
                       );
    @endcode
 */
hash bindInOut(auto value, *string type) [flags=CONSTANT,NAMED_ARGS] {
    QoreHashNode *h = new QoreHashNode(autoTypeInfo);
    if (type)
       h->setKeyValue("type", type->refSelf(), xsink);
    h->setKeyValue("value", value.refSelf(), xsink);
    return h;
}

//! returns a value to be used to bind a Qore value as an Oracle object
/** @param type_name the name of the Oracle type to bind
    @param values a hash where the keys are Oracle object attributes

    @return a hash value which can be used to bind the given value as the given object in an SQL statement with the following keys:
    - \c "type": a constant string \c "OracleObject"
    - \c "^oratype^": the value of the \c type_name argument
    - \c "^values^": the value of the \c values argument

    @par Example:
    @code
$db.exec("insert into object_table (obj) values (%v)", bindOracleObject("MY_OBJECT", $h));
    @endcode
 */
hash bindOracleObject(string type_name, hash<auto> values) [flags=CONSTANT,NAMED_ARGS] {
    QoreHashNode* h = new QoreHashNode(autoTypeInfo);
    h->setKeyValue("type", new QoreStringNode(ORACLE_OBJECT), xsink);
    h->setKeyValue("^oratype^", type_name->refSelf(), xsink);
    h->setKeyValue("^values^", values->refSelf(), xsink);
    return h;
}

//! returns a value to be used to describe a placeholder buffer for retrieving an Oracle object as an output value
/** @param type_name the name of the Oracle object type to bind for the placeholder buffer

    @return a hash value which can be used to describe an output placeholder buffer as an object buffer of the given type in an SQL statement with the following keys:
    - \c "type": a constant string \c "OracleObject"
    - \c "value": the value of the \c type_name argument

    @par Example:
    @code
my hash $h = $db.exec("begin my_pkg.get_obj(:retval); end;", placeholderOracleObject("MY_OBJECT")).retval;
    @endcode
 */
hash placeholderOracleObject(string type_name) [flags=CONSTANT,NAMED_ARGS] {
    QoreHashNode* h = new QoreHashNode(autoTypeInfo);
    h->setKeyValue("type", new QoreStringNode(ORACLE_OBJECT), xsink);
    h->setKeyValue("value", type_name->refSelf(), xsink);
    return h;
}

//! returns a value to be used to bind a Qore value as an Oracle collection
/** @param type_name the name of the Oracle collection type to bind
    @param values a list of values for the collection

    @return a hash value which can be used to bind the given value as the given collection in an SQL statement with the following keys:
    - \c "type": a constant string \c "OracleCollection"
    - \c "^oratype^": the value of the \c type_name argument
    - \c "^values^": the value of the \c values argument

    @par Example:
    @code
$db.exec("insert into object_table (obj) values (%v)", bindOracleObject("MY_OBJECT", $h));
    @endcode
 */
hash bindOracleCollection(string type_name, list<auto> values) [flags=CONSTANT,NAMED_ARGS] {
    QoreHashNode * h = new QoreHashNode(autoTypeInfo);
    h->setKeyValue("type", new QoreStringNode(ORACLE_COLLECTION), xsink);
    h->setKeyValue("^oratype^", type_name->refSelf(), xsink);
    h->setKeyValue("^values^", values->refSelf(), xsink);
    return h;
}

//! returns a value to be used to describe a placeholder buffer for retrieving an Oracle collection as an output value
/** @param type_name the name of the Oracle collection type to bind for the placeholder buffer

    @return a hash value which can be used to describe an output placeholder buffer as a collection buffer of the given type in an SQL statement with the following keys:
    - \c "type": a constant string \c "OracleCollection"
    - \c "value": the value of the \c type_name argument

    @par Example:
    @code
my hash $h = $db.exec("begin my_pkg.get_collection(:retval); end;", placeholderOracleCollection("MY_COLLECTION")).retval;
    @endcode
 */
hash placeholderOracleCollection(string type_name) [flags=CONSTANT,NAMED_ARGS] {
    QoreHashNode * h = new QoreHashNode(autoTypeInfo);
    h->setKeyValue("type", new QoreStringNode(ORACLE_COLLECTION), xsink);
    h->setKeyValue("value", type_name->refSelf(), xsink);
    return h;
}

//! Sets the Oracle session attributes reported for all statements that the current thread executes
/** The values are applied to whichever Oracle connection executes each statement, commit, or rollback on behalf of
    the current thread, including pooled connections acquired through a @ref Qore::SQL::DatasourcePool
    "DatasourcePool".  They are set as OCI session attributes, which Oracle receives with the statement itself, so
    no additional statement or server round trip is made, and setting them does not acquire a connection or start
    a transaction.

    A connection that executes a statement for a thread without session information has any values left by another
    thread cleared, so values never leak between threads sharing pooled connections.

    @param info the new session information for the current thread, replacing any previous value; keys that are
    missing or empty are reported as \c NULL; \c NOTHING or a hash without any non-empty value clears the
    session information for the current thread

    @par Example:
    @code{.py}
Oracle::setThreadSessionInfo(<OracleSessionInfo>{
    "module": "order-import:1.0",
    "action": "batch 42",
    "client_info": "workflow:ORDER-IMPORT:1.0",
});
on_exit Oracle::setThreadSessionInfo();
pool.select("select * from orders where status = %v", "NEW");
    @endcode

    @throw ORACLE-SESSION-INFO-ERROR a value cannot be converted to UTF-8

    @note
    - values longer than 64 bytes are truncated on a character boundary
    - the session information belongs to the current thread and is freed when the thread terminates
    - mixing this function with direct calls to the \c DBMS_APPLICATION_INFO or \c DBMS_SESSION packages on the
      same connection is not supported: the driver only tracks the values that it set itself

    @see
    - @ref Qore::Oracle::getThreadSessionInfo() "getThreadSessionInfo()"
    - @ref oracleora_thread_session_infoguide

    @since oracle 3.4.1
*/
nothing setThreadSessionInfo(*hash<OracleSessionInfo> info) [flags=NAMED_ARGS;dom=DATABASE] {
    ora_set_thread_session_info(info, xsink);
}

//! Returns the Oracle session attributes set for the current thread
/** @return the session information set for the current thread with
    @ref Qore::Oracle::setThreadSessionInfo() "setThreadSessionInfo()" (with values longer than 64 bytes
    truncated), or \c NOTHING if none is set

    @par Example:
    @code{.py}
*hash<OracleSessionInfo> prev = Oracle::getThreadSessionInfo();
Oracle::setThreadSessionInfo(<OracleSessionInfo>{"module": "report", "action": "monthly"});
on_exit Oracle::setThreadSessionInfo(prev);
    @endcode

    @see
    - @ref Qore::Oracle::setThreadSessionInfo() "setThreadSessionInfo()"
    - @ref oracleora_thread_session_infoguide

    @since oracle 3.4.1
*/
*hash<OracleSessionInfo> getThreadSessionInfo() [flags=RET_VALUE_ONLY;dom=DATABASE] {
    return ora_get_thread_session_info_hash(xsink);
}
///@}
